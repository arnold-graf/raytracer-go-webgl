    if (hits_edge_packed(fp, aa_hits[pixel_index(gid.x + 1u, gid.y)])) {
      dx = dx + 1;
    }
  }
  if (gid.y > 0u) {
    if (hits_edge_packed(fp, aa_hits[pixel_index(gid.x, gid.y - 1u)])) {
      dy = dy - 1;
    }
  }
  if (gid.y + 1u < hgt) {
    if (hits_edge_packed(fp, aa_hits[pixel_index(gid.x, gid.y + 1u)])) {
      dy = dy + 1;
    }
