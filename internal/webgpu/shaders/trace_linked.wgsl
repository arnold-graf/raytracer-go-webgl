// aa_resolve is the second AA pass: compare neighbor hit fingerprints and only
// supersample pixels that sit on a geometric edge.
@compute @workgroup_size(8, 8, 1) fn aa_resolve(@builtin(global_invocation_id) gid: vec3<u32>) {
  if (gid.x >= params.width || gid.y >= params.height) {
    return;
  }
  let g2 = vec2<u32>(gid.xy);
  let idx = pixel_index(gid.x, gid.y);
  let fp = aa_hits[idx];
  let edge = analyze_edge(g2, fp);
  if (edge.w < 0.5) {
    return;
  }
  let col = supersample_edge(f32(gid.x), f32(gid.y), hdr_pixels[idx].xyz, edge.xy);
  write_pixel(g2, col);
}

fn clamp01(x: f32) -> f32 {
  return clamp(x, 0.0, 1.0);
}

struct Hit {
  t: f32,
  idx: u32,
  kind: u32,
  inst_idx: u32, // 0xffffffff when the hit is on static (non-instanced) geometry
}

const HIT_NO_INSTANCE: u32 = 0xffffffffu;

const PROF_PATH_SEGS: u32 = 1u;

fn accumulate_flame(ro: vec3<f32>, rd: vec3<f32>, max_t: f32, ts: f32) -> vec3<f32> {
  var accum = vec3<f32>(0.0, 0.0, 0.0);
  let n = params.campfire_count;
  for (var ci = 0u; ci < n; ci = ci + 1u) {
    let cf = campfires[ci];
    if (!campfire_flame_enabled(cf)) {
      continue;
    }
    let bounds = flame_bounds_t(ro, rd, cf, max_t);
    if (bounds.x < 0.0) {
      continue;
    }
    let span = bounds.y - bounds.x;
    let step_len = span / f32(FLAME_MARCH_STEPS);
    var pos = ro + rd * (bounds.x + step_len * 0.5);
    let ph = cf.phase.x;
    let flick = 0.6 * sin(ts * 7.0 * cf.param.w + ph) + 0.3 * sin(ts * 13.0 * cf.param.w + ph * 2.1);
    let flick_gain = 0.85 + 0.25 * flick * cf.param.z;
    for (var s = 0u; s < FLAME_MARCH_STEPS; s = s + 1u) {
      let d = flame_density_at(pos, cf, ts);
      if (d > 0.002) {
        let col = flame_color_at(pos, cf);
        accum = accum + col * d * step_len * flick_gain * FLAME_BRIGHTNESS;
      }
      pos = pos + rd * step_len;
    }
  }
  return accum;
}

const MAT_DIFFUSE: u32 = 0u;

const MAT_EMIT: u32 = 5u; // scene.MatEmit

// Nudge ray origins off surfaces before shadow and bounce rays.
const SURFACE_EPSILON: f32 = 5e-4;

const MAT_MIRROR: u32 = 1u;

const MAT_METAL: u32 = 3u;

const MAT_GLASS: u32 = 4u;

fn shade_diffuse(hp: vec3<f32>, alb: vec3<f32>, n: vec3<f32>, ep: vec3<f32>, tw: vec3<f32>) -> vec3<f32> {
  var lit = alb * scene_ambient(n);
  for (var i = 0u; i < params.light_count; i = i + 1u) {
    lit = add_point_light(lit, hp, alb, n, ep, lights[i], tw);
  }
  for (var ci = 0u; ci < params.campfire_count; ci = ci + 1u) {
    let cf = campfires[ci];
    let core = cf.core.xyz;
    let cl = core - hp;
    let cd2 = dot(cl, cl);
    let cull = campfire_cull(cf);
    if (cd2 > cull.x) {
      continue;
    }
    if (params.shadows != 0u) {
      var cdist = sqrt(cd2);
      if (cdist == 0.0) {
        cdist = 1.0;
      }
      let cdir = cl / cdist;
      let ndl = dot(n, cdir);
      if (ndl >= 0.001) {
        let att = min(1.0, 1.0 / (LIGHT_ATTEN_BASE + cd2 * LIGHT_ATTEN_QUADRATIC));
        let peak = att * ndl * cf.param.x * max(alb.x, max(alb.y, alb.z));
        if (tw_peak(tw) * peak >= SHADOW_SKIP_EPS) {
          if (shadowed(ep, cdir, cdist)) {
            continue;
          }
        }
      }
    }
    let ts = params.time * cf.param.w;
    for (var j = 0u; j < 3u; j = j + 1u) {
      let sl = campfire_sublight(cf, j, ts);
      lit = add_point_light_raw(lit, hp, alb, n, ep, sl.pos, sl.col, cull.x, cull.y, tw, vec3<f32>(0.0, 1.0, 0.0), 0.0);
