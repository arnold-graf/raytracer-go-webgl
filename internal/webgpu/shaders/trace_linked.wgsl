        var r_skip = false;
        if depth == 0u && blur.x > 0.0 && refl_chan_on() {
          refl_blur = blur.x;
          lobe_n = n;
          lobe_d = hit.t;
          if lobe_skip(gloss_mode, blur.x) {
            refl_t = -2.0;
            r_skip = true;
          } else {
            rtag = RAYSEG_REFL;
          }
        }
        if !r_skip {
          stack[sp] = RaySeg(ep, rd_refl, tw * w_refl, depth + 1u, rtag);
          sp = sp + 1u;
        }

        // The thin-glass ghost stays inline and unfiltered for now: it
        // is a second-pane reflection at a different angle, so it is not
        // the lobe either channel is holding out, and at 0.42 of an
        // already-Fresnel weight it is faint enough to leave sharp.
        if thin && depth == 0u && params.thin_glass_ghost != 0u && sp < MAX_SEGS {
          let slide = thin_glass_ghost_slide(n, rd);
          let surf_shift = thin_glass_ghost_surface_shift(cosi);
          let ang = min(surf_shift / max(hit.t, 0.35), THIN_GLASS_GHOST_ANG_MAX);
          let rd_pane2 = normalize(rd + slide * ang);
          let ghost_w = w_refl * THIN_GLASS_GHOST_WEIGHT;
          var ghost_rd = reflect(rd_pane2, n);
          if rough > 0.001 {
            ghost_rd = jitter_dir(ghost_rd, hp, rough * 1.5);
          }
          if ghost_w > refl_min && twm * ghost_w > SEG_MIN_CONTRIB {
            stack[sp] = RaySeg(ep, ghost_rd, tw * ghost_w, max_depth, RAYSEG_GHOST);
            sp = sp + 1u;
          }
        }
      }
      if spec_strength > 0.0 {
        let c_spec = tw * shade_specular(hp, n, ep, tw, rd, spec_strength, shininess);
        accum = accum + c_spec;
        refl_acc = refl_acc + c_spec * rmask;
        refr_acc = refr_acc + c_spec * tmask;
      }
      continue;
    }

    // Diffuse / checker, plus mirror/metal/glass falling through here at the
    // depth cap (or when reflections are disabled): shaded as diffuse.
    var lit = vec3<f32>(0.0);
    if gi_in_probe {
      // Probe rays are the whole cost of this feature, so they get a
      // shading path that keeps every light type and replaces only the
      // per-light shadow loop with one importance-sampled ray.
      lit = gi_probe_shade(hp, alb, n, ep, tw, rd);
    } else {
      lit = shade_diffuse(hp, alb, n, ep, tw, rd, spec_strength, shininess);
    }
    if depth == 0u {
      // Snapshot before any deeper segment shades and resets these.
      // Weighted by tw so a shadow seen through glass is softened by the
      // same amount its light was attenuated.
      sh_out = shadow_aux_snapshot(tw, n, hit.t);
    }
    let refl = surf.z;
    // A glossy lobe on a *primary* hit is the sheen the scene author asked
    // for, however faint, so it only has to clear the generic
    // SEG_MIN_CONTRIB floor. Only reflections seen inside another
    // reflection are pruned by GLOSSY_MIN_CONTRIB.
    var glossy_min = GLOSSY_MIN_CONTRIB;
    if depth == 0u {
      glossy_min = SEG_MIN_CONTRIB;
    }
    if refl > 0.0 && reflective && twm * refl > glossy_min && (mat == MAT_DIFFUSE || mat == MAT_CHECKER) && sp < MAX_SEGS {
      let c_lit_r = tw * lit * (1.0 - refl);
      accum = accum + c_lit_r;
      refl_acc = refl_acc + c_lit_r * rmask;
      refr_acc = refr_acc + c_lit_r * tmask;
      if depth == 0u {
        // A glossy surface keeps only (1 - refl) of its direct lighting;
        // the rest is the reflected lobe. The record has to match, or
        // the filter adds back light this pixel never had.
        sh_out.full = sh_out.full * (1.0 - refl);
      }
      // The filter wants a *mirror* ray: the blur is applied afterwards,
      // from the roughness and the reflected distance, so perturbing the
      // ray here would only sample that blur once and call it noise.
      var grd = jitter_dir(reflect(rd, n), hp, rough);
      var gtag = inherit;
      // The ray keeps its jitter: `rough` is world-space roughness and
      // stays exactly what it was. reflect_blur only decides whether this
      // lobe is held out and widened afterwards.
      if depth == 0u && blur.x > 0.0 && refl_chan_on() {
        refl_blur = blur.x;
        lobe_n = n;
        lobe_d = hit.t;
        if lobe_skip(gloss_mode, blur.x) {
          // -2 marks the lobe as owed rather than absent, which is
          // what refl_fill looks for; -1 stays "no lobe at all".
          refl_t = -2.0;
          continue;
        }
        gtag = RAYSEG_REFL;
      }
      prof_inc(PROF_DIFFUSE_REFL, 1u);
      stack[sp] = RaySeg(ep, grd, tw * refl, depth + 1u, gtag);
      sp = sp + 1u;
      continue;
    }
    let c_lit = tw * lit;
    accum = accum + c_lit;
    refl_acc = refl_acc + c_lit * rmask;
    refr_acc = refr_acc + c_lit * tmask;
  }
  prof_max(PROF_MAX_SEGS, max_sp);
  return TraceResult(max(accum - refl_acc - refr_acc, vec3<f32>(0.0, 0.0, 0.0)), refl_acc, refl_t, refl_blur, refr_acc, refr_t, refr_blur, lobe_n, lobe_d, primary, sh_out);
}

// ---------------------------------------------------------------- grain ----
//
// COLOR_QUANT_GRAIN replaces the ordered dither with Monte-Carlo-shaped grain,
// matched to the experimental path tracer's own noise rather than guessed at.
// Measured by differencing a 2spp render against a 512spp reference of the same
// frame, in linear radiance:
//
//   sigma vs brightness   sigma ~ L^0.79. Absolute grain grows with brightness,
//                         but *relative* grain falls -- sigma/L is 2.5 down in
//                         the shadows against 1.3 in the lit areas. That is the
//                         whole reason path-traced shadows read as grainier, and
//                         a flat-amplitude noise misses it completely.
//   channel correlation   R-G 0.94, G-B 0.83, R-B 0.66. Mostly common-mode with
//                         a real chromatic component, blue the least tied.
//   autocorrelation       0.002 at lag 1, and nothing above 0.003 out to lag 16.
//                         The grain is *white*: one band, no structure at any
//                         coarser scale. Spatially banded noise would look less
//                         like the path tracer, not more.
//   tails                 p50 0.42 sigma, p90 1.19, p99 4.26, p99.9 7.48,
//                         against a gaussian's 0.67 / 1.64 / 2.58 / 3.29. Most
//                         pixels nearly clean and a few far out -- that sparse
//                         speckle is what the eye reads as "path traced", and a
//                         plain gaussian looks like video noise instead.
//
// The tails are reproduced with a two-component scale mixture, which fits all
// four percentiles at once: GRAIN_HEAVY_FRAC of pixels get GRAIN_HEAVY_SCALE
// times the width. Predicted from that mixture: 0.42 / 1.14 / 4.46 / 6.98.
const COLOR_QUANT_GRAIN: u32 = 4u;

// The knob. Grain is linear in it, and it is an equivalent sample count that
// sets the scale: the measured 2spp frame sits at about 1.08, and halving the
// strength is worth 4x the samples. 0.13 is roughly a 128spp look.
const GRAIN_STRENGTH: f32 = 0.07;

// Measured exponent of sigma against brightness. 0 would be flat-amplitude
// noise, 1 would be purely multiplicative.
const GRAIN_EXP: f32 = 0.79;

// The scale mixture behind the heavy tails.
const GRAIN_HEAVY_FRAC: f32 = 0.10;

const GRAIN_HEAVY_SCALE: f32 = 5.0;

// Per-channel independent share, the rest being common to all three. Set so the
// channel correlations land near the measured ones; blue is given more of its
// own because it measured least correlated.
const GRAIN_CHROMA_RG: f32 = 0.30;

const GRAIN_CHROMA_B: f32 = 0.60;

// Grain resampled every frame, as the path tracer does. Off by default: a still
// frame that keeps crawling reads as a broken screen rather than as grain, and
// this is a *dither* -- it belongs to the pixel grid, the way the bayer pattern
// it replaces does.
const GRAIN_ANIMATE: bool = false;

// Tried and rejected: blue noise for the static pattern.
//
// The reasoning was sound and the result was not. Frozen white noise keeps its
// low-frequency energy, which no longer averages across frames and can show as
// blotching, and blue noise is what dither masks use to avoid exactly that. But
// a texture would have cost a binding (31 of 32 are in use), so the generator
// had to be analytic -- Jimenez's interleaved gradient noise -- and an analytic
// function is *periodic*, which is the one thing this filter must not be.
//
// It shows up in the measurement before the eye finds it: autocorrelation along
// a scanline went -0.655 at lag 1, correctly negative for blue noise, but then
// oscillated -- +0.577, -0.356, -0.395, +0.630 at lags 2, 3, 6, 16. That is a
// repeating pattern, not noise with a shaped spectrum. On screen it is a fine
// diagonal crosshatch: the ordered-dither look this mode exists to replace.
//
// The heavy-tail selector makes it worse than it would otherwise be. Thresholding
// a smooth deterministic function picks a periodic *subset* of pixels, so the
// sparse speckle that carries the whole character lands on a lattice.
//
// White noise it is. At this amplitude the speckle is sparse enough that
// clumping never becomes visible, which is what the worry was about.
fn grain_pcg(v: u32) -> u32 {
  let state = v * 747796405u + 2891336453u;
  let word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
  return (word >> 22u) ^ word;
}

fn grain_u01(seed: u32) -> f32 {
  // Nudged off zero so the log in the Box-Muller transform stays finite.
  return max(f32(grain_pcg(seed)) * (1.0 / 4294967296.0), 1e-7);
}

// Two independent standard normals from one seed.
fn grain_gauss2(seed: u32) -> vec2<f32> {
  let u1 = grain_u01(seed);
  let u2 = grain_u01(seed ^ 0x9e3779b9u);
  let r = sqrt(-2.0 * log(u1));
  let a = 6.2831853 * u2;
  return vec2<f32>(r * cos(a), r * sin(a));
}

// Unit-variance triangular noise, from two uniforms. Used only for the chroma
// terms: they carry a small share of the variance and sit under a common-mode
// term that is a true gaussian, so the shape of the sum is set by that one. It
// saves a second Box-Muller -- a log, a sqrt and a sincos -- per pixel.
fn grain_tri(seed: u32) -> f32 {
  return (grain_u01(seed) + grain_u01(seed ^ 0x27d4eb2fu) - 1.0) * 2.4494897;
}

// pt_grain returns the grain to add to a pixel's *linear* radiance, before the
// tonemap. That is where Monte Carlo noise actually lives, and it is why a
// firefly here gets compressed by the highlight rolloff exactly as one from the
// path tracer would.
fn pt_grain(gid: vec2<u32>, col: vec3<f32>) -> vec3<f32> {
  var frame = 0u;
  if GRAIN_ANIMATE {
    frame = u32(params.time * 60.0);
  }
  let seed = (gid.y * 1973u + gid.x * 9277u) ^ (frame * 26699u);
  let u_a = grain_u01(seed);
  let u_b = grain_u01(seed ^ 0x9e3779b9u);
  let u_h = grain_u01(seed ^ 0xc2b2ae35u);
  let bm_r = sqrt(-2.0 * log(u_a));
  let bm_a = 6.2831853 * u_b;
  // `common` is a WGSL reserved word.
  let base_n = bm_r * cos(bm_a);
  let chroma_a = bm_r * sin(bm_a);

  // One draw decides whether this pixel is in the wide component, so a firefly
  // lands on all three channels at once, as a bright path would.
  var scale = 1.0;
  if u_h < GRAIN_HEAVY_FRAC {
    scale = GRAIN_HEAVY_SCALE;
  }
  // Unit variance across the mixture, so GRAIN_STRENGTH means the same thing
  // whatever the tail settings are.
  let norm = inverseSqrt(mix(1.0, GRAIN_HEAVY_SCALE * GRAIN_HEAVY_SCALE, GRAIN_HEAVY_FRAC));
  let cw_rg = sqrt(max(1.0 - GRAIN_CHROMA_RG * GRAIN_CHROMA_RG, 0.0));
  let cw_b = sqrt(max(1.0 - GRAIN_CHROMA_B * GRAIN_CHROMA_B, 0.0));
  let chroma_b = grain_tri(seed ^ 0x165667b1u);
  let chroma_c = grain_tri(seed ^ 0xd3a2646cu);
  let unit = vec3<f32>(cw_rg * base_n + GRAIN_CHROMA_RG * chroma_a, cw_rg * base_n + GRAIN_CHROMA_RG * chroma_b, cw_b * base_n + GRAIN_CHROMA_B * chroma_c);
  let pix_lum = dot(col, vec3<f32>(0.2126, 0.7152, 0.0722));
  let sigma = GRAIN_STRENGTH * pow(max(pix_lum, 0.0), GRAIN_EXP);
  return unit * (sigma * scale * norm);
}

// quantize_rgb reduces dithered 0..255 RGB to a retro color depth. mode 1 is
// classic 15-bit (5-5-5); mode 2 is crush — 24 levels per channel with heavy dither.
fn quantize_rgb(rgb: vec3<f32>, mode: u32) -> vec3<f32> {
  if mode == 3u || mode == COLOR_QUANT_GRAIN {
    return rgb;
  }
  if mode == 0u {
    return rgb;
  }
  if mode == 1u {
    let q = floor(rgb * 31.0 / 255.0 + 0.5);
    return q * (255.0 / 31.0);
  }
  let q = floor(rgb * 23.0 / 255.0 + 0.5);
  return q * (255.0 / 23.0);
}

// bayer_offset returns a per-pixel dither nudge in 0..255 space before quantize.
fn bayer_offset(gid: vec2<u32>, quant_mode: u32) -> f32 {
  var bayer = array<u32, 16>(0u, 8u, 2u, 10u, 12u, 4u, 14u, 6u, 3u, 11u, 1u, 9u, 15u, 7u, 13u, 5u);
  if quant_mode == COLOR_QUANT_GRAIN {
    // The grain is the dither: it already breaks up the quantization banding
    // the bayer pattern exists to hide.
    return 0.0;
  }
  let bayer_idx = (gid.y & 3u) * 4u + (gid.x & 3u);
  let n = f32(bayer[bayer_idx]) / 16.0 - 0.5;
  if quant_mode == 2u {
    return n * (255.0 / 23.0) * 1.5;
  }
  return n * 6.0;
}

// pixel_ray_dir builds a normalized camera ray through fractional pixel coords
// (gx, gy) plus a sub-pixel offset (sx, sy) in 0..1.
fn pixel_ray_dir(gx: f32, gy: f32, sx: f32, sy: f32) -> vec3<f32> {
  let u = (gx + sx) / f32(params.width) * 2.0 - 1.0;
  let v = 1.0 - (gy + sy) / f32(params.height) * 2.0;
  return normalize(params.fwd.xyz + params.right.xyz * (u * params.aspect * params.fov_scale) + params.up.xyz * (v * params.fov_scale));
}

fn pixel_index(x: u32, y: u32) -> u32 {
  return y * params.width + x;
}

// AA_GEOM_MIN_LEVELS is the display-space luminance gap, in 8-bit levels, that
// two neighboring pixels on *different surfaces* must span before their shared
// boundary is worth a supersample.
//
// The pass-1 fingerprint test (hits_edge_packed) answers "do these pixels sit on
// different primitives", which is a weaker signal than "is there a visible jaggy
// here". Scene geometry is authored as many small boxes — a server rack, a wall
// of panels, a skyscraper facade — so a continuous, uniformly lit surface is
// covered in fingerprint boundaries with nothing to antialias. The gate is safe
// because the output is quantized: at 15-bit color depth (color_quant == 1) each
// channel keeps 32 levels, ~8.2 display levels apart, so neighbors closer than
// that largely land in the same bucket. Kept well below one quantization step so
// dithered near-threshold edges still resolve.
const AA_GEOM_MIN_LEVELS: f32 = 3.0;

// AA_SHADE_MIN_CURVE is the same idea for edges *within* one surface: shadow
// terminators, contact shadows, and texture boundaries, none of which change the
// primary hit and so were invisible to the fingerprint test.
//
// The test is the second difference of luminance across the pixel,
// |lo + hi - 2*center|, rather than a plain neighbor gap. A plain gap fires
// everywhere on the smooth falloff of a point light, where a supersample only
// re-averages a value the gradient already got right — a large ray cost for no
// visible change. Curvature is near zero along any linear ramp and jumps to the
// full step height where luminance *bends*, which is exactly where a hard shadow
// boundary produces a staircase.
//
// Sits just above one 15-bit quantization step (~8.2 levels), so a staircase
// that is merely a banding artifact — where the extra ray would land in the same
// output bucket — does not qualify. Measured on the office-sunset views, cost
// over the silhouette-only detector is +0.8ms at 10.0 and +1.2ms at 5.0, the
// latter mostly spent chasing dither noise.
//
//	 5.0 → below one quantization step; pays for dither noise
//	10.0 → current default; hard shadow and contact-shadow edges
//	48.0 → only the highest-contrast shadow boundaries
const AA_SHADE_MIN_CURVE: f32 = 10.0;

// display_luma is the Rec.709 luminance of the tonemapped color in 0..255, the
// space the eye judges an edge in. Pass 1 stashes it in hdr_pixels[].w so the
// resolve pass compares a scalar per neighbor instead of retonemapping four.
fn display_luma(c: vec3<f32>) -> f32 {
  let t = tonemap(c);
  return (0.2126 * t.x + 0.7152 * t.y + 0.0722 * t.z) * 255.0;
}

// AANeighbor is one neighboring pixel's contribution to the edge decision.
struct AANeighbor {
  // luma is the neighbor's display luminance, or the center's when off-screen
  // so it reads as a flat continuation and never invents an edge.
  luma: f32,
  // surface_edge is true when the neighbor's primary hit is a different
  // surface, i.e. the boundary is a silhouette rather than shading.
  surface_edge: bool,
  inside: bool,
}

fn aa_neighbor(fp: u32, center_luma: f32, x: u32, y: u32, inside: bool) -> AANeighbor {
  if !inside {
    return AANeighbor(center_luma, false, false);
  }
  let idx = pixel_index(x, y);
  return AANeighbor(hdr_pixels[idx].w, hits_edge_packed(fp, aa_hits[idx]), true);
}

// aa_axis_tap picks the sub-pixel tap along one axis: 0.25 toward the low
// neighbor, 0.75 toward the high one, or 0.5 for "no edge on this axis".
//
// The tap always aims at the stronger of the two sides. Aiming matters because
// the resolve pass averages the center sample with this single extra ray, so a
// tap at 0.5 would just re-trace the center and change nothing.
// Returns vec2(tap, kind), kind being 0 for no edge, 1 for a silhouette and 2
// for same-surface curvature. The kind is only read by the profile counters.
fn aa_axis_tap(center: f32, lo: AANeighbor, hi: AANeighbor) -> vec2<f32> {
  let d_lo = abs(center - lo.luma);
  let d_hi = abs(center - hi.luma);
  var kind = 0.0;
  var edge = (lo.surface_edge && d_lo >= AA_GEOM_MIN_LEVELS) || (hi.surface_edge && d_hi >= AA_GEOM_MIN_LEVELS);
  if edge {
    kind = 1.0;
  }
  if !edge && lo.inside && hi.inside {
    edge = abs(lo.luma + hi.luma - 2.0 * center) >= AA_SHADE_MIN_CURVE;
    if edge {
      kind = 2.0;
    }
  }
  if !edge {
    return vec2<f32>(0.5, 0.0);
  }
  if d_lo >= d_hi {
    return vec2<f32>(0.25, kind);
  }
  return vec2<f32>(0.75, kind);
}

// hits_edge is true when two packed primary hits belong to different surfaces.
fn hits_edge_packed(a: u32, b: u32) -> bool {
  if a == b {
    return false;
  }
  if a == 0xffffffffu && b == 0xffffffffu {
    return false;
  }
  return true;
}

fn pack_hit(h: Hit) -> u32 {
  if h.idx == 0xffffffffu {
    return 0xffffffffu;
  }
  return h.kind | (h.idx << 4u) | (h.inst_idx << 20u);
}

// analyze_edge finds which neighbors differ and picks a sub-pixel tap toward them
// (corner when two axes disagree, edge midpoint when only one does).
// Returns vec4(tap.x, tap.y, _, active) with active = 1 when supersampling is needed.
fn analyze_edge(gid: vec2<u32>, fp: u32, luma: f32) -> vec4<f32> {
  let left = aa_neighbor(fp, luma, max(gid.x, 1u) - 1u, gid.y, gid.x > 0u);
  let right = aa_neighbor(fp, luma, gid.x + 1u, gid.y, gid.x + 1u < params.width);
  let down = aa_neighbor(fp, luma, gid.x, max(gid.y, 1u) - 1u, gid.y > 0u);
  let up = aa_neighbor(fp, luma, gid.x, gid.y + 1u, gid.y + 1u < params.height);
  let sx = aa_axis_tap(luma, left, right);
  let sy = aa_axis_tap(luma, down, up);
  if sx.x == 0.5 && sy.x == 0.5 {
    return vec4<f32>(0.5, 0.5, 0.0, 0.0);
  }
  prof_inc(PROF_AA_TASKS, 1u);
  let kinds = u32(sx.y) | u32(sy.y);
  if (kinds & 1u) != 0u {
    prof_inc(PROF_AA_GEOM, 1u);
  }
  if (kinds & 2u) != 0u {
    prof_inc(PROF_AA_SHADE, 1u);
  }
  return vec4<f32>(sx.x, sy.x, 0.0, 1.0);
}

// supersample_edge blends the pass-1 center sample with one tap toward the edge.
//
// The tap traces a *hard* shadow while `center` has already been softened, so
// blending them 50/50 would put a hard edge back into exactly the pixels the
// penumbra filter smoothed. The tap has to be given the same treatment — but it
// is a different sub-pixel, and AA fires precisely where that sub-pixel lands on
// *different geometry*, which is the whole reason the pixel was flagged.
//
// So the tap is corrected with the filter's conclusion, not its arithmetic. The
// filter's conclusion is a target visibility: "a pixel here should be blocking
// this fraction of its light". That is a property of the neighbourhood, it is
// smooth by construction, and it transfers one sub-pixel over. The correction is
// then evaluated against the tap's *own* occlusion and its *own* unoccluded
// light, both of which ray_color already computed for it.
//
// Adding the centre's finished radiance delta instead — which is what this did —
// pushes the centre's surface, albedo and light onto a sample that may be on
// another step of a staircase entirely. Along stair nosings, where every shadow
// edge crosses a geometric edge, that read as the softening being undone: ragged,
// re-hardened shadow borders visible only with AA on.
// AA_TAPS is how many extra rays a flagged pixel traces. Shipping value is 1:
// the resolve pass is throughput-bound, so cost is very close to linear in this
// (measured 2.05x / 3.05x / 5.05x / 6.97x at 2 / 3 / 5 / 7 taps). Higher values
// exist to generate a reference for tuning the single tap against.
const AA_TAPS: u32 = 1u;

// AA_TAP_REACH is how far from the pixel centre the single aimed tap sits.
//
// With one extra ray the pixel is estimated from two samples, the centre plus
// this one, and the pair is *not* symmetric about the centre — so the estimator
// is biased toward whichever side the tap was aimed at, and the reach sets how
// strong that bias is. Tuned against a 31-tap reference; see
// docs/adaptive-aa.md.
const AA_TAP_REACH: f32 = 0.35;

// AA_TAP_WEIGHT is the tap's share of the blend, the centre taking the rest.
const AA_TAP_WEIGHT: f32 = 0.30;

// van der Corput radical inverse, base 2 — the second dimension of a Hammersley
// set. Only used to place reference taps.
fn aa_radical_inverse(bits_in: u32) -> f32 {
  var bits = bits_in;
  bits = (bits << 16u) | (bits >> 16u);
  bits = ((bits & 0x55555555u) << 1u) | ((bits & 0xAAAAAAAAu) >> 1u);
  bits = ((bits & 0x33333333u) << 2u) | ((bits & 0xCCCCCCCCu) >> 2u);
  bits = ((bits & 0x0F0F0F0Fu) << 4u) | ((bits & 0xF0F0F0F0u) >> 4u);
  bits = ((bits & 0x00FF00FFu) << 8u) | ((bits & 0xFF00FF00u) >> 8u);
  return f32(bits) * 2.3283064365386963e-10;
}

// aa_tap_offset places tap i inside the pixel. One tap uses the aimed offset the
// classifier chose, because a single sample averaged with the centre has to be
// put where it will actually disagree. Above one the aim is dropped for a
// Hammersley set, which covers the pixel evenly and so converges on the box
// average this is all trying to estimate.
fn aa_tap_offset(i: u32, aimed: vec2<f32>) -> vec2<f32> {
  if AA_TAPS == 1u {
    return aimed;
  }
  return vec2<f32>((f32(i) + 0.5) / f32(AA_TAPS), aa_radical_inverse(i));
}

// True when an AA tap's glossy lobe left from the same surface as the centre's,
// so the filtered lobe refl_blur_v parked in the centre's record describes the
// tap as well.
//
// This is lobe_compatible's test with the tap's sub-pixel offset taken into
// account, which is to say without it: the tap shares the centre's pixel, so its
// view ray is the centre's to well within REFL_DEPTH_REL and the depth
// prediction collapses to the centre's own depth. The constants are the filter's
// on purpose — if the filter would have let these two lobes mix, the tap may
// take the result of mixing them.
//
// Both lobes are held out of colour only when the surface asked for a blur
// (`blur.x > 0.0` at the hit), so on a mirror both sides of the branch add zero
// and this changes nothing.
fn aa_tap_same_lobe(aux: ShadowAux, res: TraceResult) -> bool {
  if aux.lobe_depth <= 0.0 || res.lobe_d <= 0.0 {
    return false;
  }
  if dot(aux.lobe_normal, res.lobe_n) < REFL_MIN_DOT {
    return false;
  }
  return abs(res.lobe_d - aux.lobe_depth) <= aux.lobe_depth * REFL_DEPTH_REL;
}

fn supersample_edge(gx: f32, gy: f32, center: vec3<f32>, tap: vec2<f32>, idx: u32) -> vec3<f32> {
  let ro = params.cam_pos.xyz;
  let aux = shadow_aux[idx];
  var sum = vec3<f32>(0.0, 0.0, 0.0);
  for (var i = 0u; i < AA_TAPS; i = i + 1u) {
    let off = aa_tap_offset(i, tap);
    let res = ray_color(ro, pixel_ray_dir(gx, gy, off.x, off.y), GLOSS_ALWAYS);
    var e = aa_tap_correct(res, aux);
    // Whose lobes the tap adds depends on where the tap landed.
    //
    // Handing it the centre's filtered lobes unconditionally is cheaper —
    // the tap need not trace them at all — and it is what the penumbra
    // correction does with its target visibility. It is not safe in
    // general. AA fires precisely where the tap lands on different
    // geometry, a glass pixel's transmitted lobe can be most of its
    // radiance, and pushing the centre's through a tap that is looking at
    // something else put 236 isolated pixels up to 190 levels out on
    // office-sunset's glass silhouettes.
    //
    // Always taking the tap's own lobes is not safe either, and a blurred
    // surface is where that shows. The centre's lobe has been through
    // refl_blur_h/v; the tap's is a single point sample of the same lobe,
    // and on a curved surface a sub-pixel shift swings the reflected ray
    // far enough to land somewhere much brighter. Blending that in at
    // AA_TAP_WEIGHT draws the unfiltered reflection back over the filtered
    // one at 30% — sharp streaks down the metal posts of the front office's
    // bookshelf (reflect_blur 0.3), where AA fires all along the highlight.
    //
    // So the tap is asked the question the filter already asks of a
    // neighbour: same reflecting surface or not. Same surface and the
    // filtered lobe describes the tap too; different geometry and only the
    // tap's own lobe does.
    if aa_tap_same_lobe(aux, res) {
      e = e + aux.refl_color + aux.refr_color;
    } else {
      e = e + res.refl + res.refr;
    }
    sum = sum + e;
  }
  if AA_TAPS == 1u {
    return center * (1.0 - AA_TAP_WEIGHT) + sum * AA_TAP_WEIGHT;
  }
  return (center + sum) / f32(AA_TAPS + 1u);
}

fn aa_tap_correct(res: TraceResult, aux: ShadowAux) -> vec3<f32> {
  var extra = res.color;
  if params.soft_shadows != 0u && aux.soft_applied > 0.0 {
    // Scaled by the *lesser* of the two unoccluded lights, not the tap's own.
    //
    // The target fraction is a statement about the centre's neighbourhood, so
    // the correction it licenses is bounded by the light the centre actually
    // has. Using the tap's own light unbounded is what put bright specks
    // along every high-contrast silhouette: AA fires exactly where the tap
    // lands on different geometry, and a tap that is fully blocked (frac 1)
    // beside a centre that is lit (target 0) then gets +1 x *its* full light
    // added back — un-shadowing a bright surface in a single pixel. Against
    // an open fire that is a visible white dot on the edge of the geometry.
    //
    // Measured on that frame: isolated bright pixels 63 -> 40, which is below
    // the 41 the previous correction produced, while keeping most of the
    // stair-shadow improvement this correction exists for (deviation from the
    // no-AA reference 0.57 -> 0.78, against 0.93 before).
    let lit_bound = min(res.sh.full, aux.full);
    extra = max(extra + (res.sh.frac - aux.frac) * lit_bound, vec3<f32>(0.0, 0.0, 0.0));
  }
  return extra;
}

fn write_pixel(gid: vec2<u32>, col: vec3<f32>) {
  var lit = col;
  if params.color_quant == COLOR_QUANT_GRAIN {
    lit = max(col + pt_grain(gid, col), vec3<f32>(0.0, 0.0, 0.0));
  }
  let toned = tonemap(lit);
  var rgb: vec3<f32>;
  if params.color_quant == 3u {
    rgb = clamp(toned * 255.0, vec3(0.0), vec3(255.0));
  } else {
    let bdt = bayer_offset(gid, params.color_quant);
    rgb = clamp(toned * 255.0 + vec3(bdt), vec3(0.0), vec3(255.0));
  }
  rgb = quantize_rgb(rgb, params.color_quant);
  let r = u32(floor(rgb.x));
  let g = u32(floor(rgb.y));
  let b = u32(floor(rgb.z));
  pixels[pixel_index(gid.x, gid.y)] = r | (g << 8u) | (b << 16u) | (255u << 24u);
}

// REFL_SPREAD converts a surface's `rough` into the half-angle its reflection is
// scattered through. jitter_dir perturbed the direction by up to 0.5*rough per
// component, so this keeps the filtered result the same width as the jittered
// one it replaces; it is the knob for overall reflection softness.
const REFL_SPREAD: f32 = 0.5;

// The same for the transmitted lobe. Equal to REFL_SPREAD today because the
// difference between the two is already carried in the roughness each lobe
// records — glass jitters transmission at `rough * 0.35` — so this is the knob
// for making them differ *beyond* that, which is the point of the split.
const REFR_SPREAD: f32 = 0.5;

// Cap and tap count are a matched pair, on the same rule as the penumbra comb:
// two more than twice the cap, so the comb steps at most one pixel at the widest
// radius and has nothing to alias against. Raise one and raise the other.
const REFL_MAX_PX: f32 = 16.0;

const REFL_TAPS: u32 = 33u;

const REFL_MIN_DOT: f32 = 0.9;

const REFL_MIN_DENOM: f32 = 0.02;

const REFL_DEPTH_REL: f32 = 0.02;

// The blur a lobe wants, in pixels. `spread` converts the surface's `rough` into
// the half-angle the lobe is scattered through; the reflection and the
// refraction keep their own, so a pane can later be frosted in transmission
// while still reflecting sharply.
fn lobe_radius_px(spread: f32, rough: f32, t_lobe: f32, depth: f32) -> f32 {
  if rough <= 0.0 || t_lobe <= 0.0 || depth <= 0.0 {
    return 0.0;
  }
  // Pixels per unit of lateral offset at unit forward distance.
  let focal_px = 0.5 * f32(params.width) / max(params.aspect * params.fov_scale, 1e-6);
  // The lobe's image sits behind the surface, so it is (depth + t) away from
  // the camera however near the surface itself is.
  let apparent = depth + t_lobe;
  return min(spread * rough * t_lobe * focal_px / max(apparent, 1e-3), REFL_MAX_PX);
}

fn refl_radius_px(rough: f32, t_lobe: f32, depth: f32) -> f32 {
  return lobe_radius_px(REFL_SPREAD, rough, t_lobe, depth);
}

fn refr_radius_px(rough: f32, t_lobe: f32, depth: f32) -> f32 {
  return lobe_radius_px(REFR_SPREAD, rough, t_lobe, depth);
}

fn refl_clamp_x(x: i32) -> i32 {
  return clamp(x, 0, i32(params.width) - 1);
}

fn refl_clamp_y(y: i32) -> i32 {
  return clamp(y, 0, i32(params.height) - 1);
}

// The tap has to sit on the same *reflecting* surface: extended as a plane and
// predicted along the tap's own view ray, so the tolerance stays tight at
// grazing incidence where a floor's depth changes fast between neighbours.
//
// It deliberately does *not* ask what the two taps are reflecting. That gate was
// written first, on the theory that a reflected silhouette would otherwise
// smear, and it is exactly backwards: a rough surface gathers over a cone that
// straddles the silhouette, so mixing the bar with the sky behind it is the
// blur, not an artifact of it. With the gate in, the reflection came back
// pin-sharp — every tap across the only edges in the frame was rejected, which
// is the one place the filter had anything to do.
//
// The reflected distance still sizes the radius. It just does not veto.
fn lobe_compatible(me: ShadowAux, t: ShadowAux, tx: i32, ty: i32, ndv0: f32) -> bool {
  if t.lobe_depth <= 0.0 {
    return false;
  }
  if dot(me.lobe_normal, t.lobe_normal) < REFL_MIN_DOT {
    return false;
  }
  let v_tap = pixel_ray_dir(f32(tx), f32(ty), 0.5, 0.5);
  let denom = dot(me.lobe_normal, v_tap);
  if abs(denom) < REFL_MIN_DENOM {
    return false;
  }
  let d_pred = me.lobe_depth * ndv0 / denom;
  return abs(t.lobe_depth - d_pred) <= me.lobe_depth * REFL_DEPTH_REL;
}

fn refl_ndv0(me: ShadowAux, gid: vec2<u32>) -> f32 {
  return dot(me.lobe_normal, pixel_ray_dir(f32(gid.x), f32(gid.y), 0.5, 0.5));
}

@compute @workgroup_size(8, 8, 1) fn main(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let ro = params.cam_pos.xyz;
  let gx = f32(gid.x);
  let gy = f32(gid.y);
  let g2 = vec2<u32>(gid.xy);
  prof_inc(PROF_PIXELS, 1u);
  // One pixel of each 2x2 block leads: it traces the glossy lobe, and the
  // other three fill from it wherever the blur is wide enough to hide the
  // difference. refl_half_ok inside ray_color makes that call per surface,
  // because only it knows the roughness at the hit.
  let lead = (gid.x & 1u) == 0u && (gid.y & 1u) == 0u;
  let tr = ray_color(ro, pixel_ray_dir(gx, gy, 0.5, 0.5), select(GLOSS_IF_SHARP, GLOSS_ALWAYS, lead));
  prof_inc(PROF_BVH_STEPS, bvh_steps_acc);
  prof_inc(PROF_PRIM_TESTS, prim_tests_acc);
  let idx = pixel_index(gid.x, gid.y);
  let soft = params.soft_shadows != 0u;
  let filt = (params.refl_filter & 1u) != 0u;

  // With the filter on the glossy lobe is left out of the pixel until
  // refl_blur_v has widened it and adds it back; with it off the lobe was
  // never held out in the first place and folds straight in here.
  var col = tr.color;
  var aux = tr.sh;
  if filt {
    // Distances are passed through, not clamped: -1 is "no lobe here", -2 is
    // "lobe owed to refl_fill", and a real distance is a real distance. Only
    // a pixel with no reflecting surface under it is forced to -1.
    aux.refl_color = tr.refl;
    aux.refl_color_h = tr.refl;
    aux.refl_radius_px = refl_radius_px(tr.refl_blur, max(tr.refl_t, 0.0), tr.lobe_d);
    aux.refl_t = select(-1.0, tr.refl_t, tr.lobe_d > 0.0);
    aux.refr_color = tr.refr;
    aux.refr_color_h = tr.refr;
    aux.refr_radius_px = refr_radius_px(tr.refr_blur, max(tr.refr_t, 0.0), tr.lobe_d);
    aux.refr_t = select(-1.0, tr.refr_t, tr.lobe_d > 0.0);
    aux.lobe_normal = tr.lobe_n;
    aux.lobe_depth = tr.lobe_d;
  } else {
    col = col + tr.refl + tr.refr;
  }

  // The soften pass needs the linear colour to add light back into, so the
  // scratch is written whenever it runs even if adaptive AA is off. It carries
  // its own normal and depth for surface continuity and does not read aa_hits.
  if params.adaptive_aa != 0u || soft || filt {
    hdr_pixels[idx] = vec4<f32>(col, display_luma(col));
  }
  if params.adaptive_aa != 0u {
    aa_hits[idx] = pack_hit(tr.primary);
  }
  if soft || filt {
    shadow_aux[idx] = aux;
  }
  write_pixel(g2, col);
}

// refl_fill hands a skipped pixel the lobe its block's lead traced. Only pixels
// marked -2 are touched, so a pixel with no glossy surface under it stays empty.
//
// The lead can be on the far side of a silhouette, in which case the four
// neighbouring blocks' leads are tried before giving up. Giving up leaves the
// lobe at zero, which reads as a missing reflection on a one-pixel rim; that is
// the cost of the scheme and it is why the radius gate exists — at a wide blur
// the rim is inside the gather of every pixel around it anyway.
@compute @workgroup_size(8, 8, 1) fn refl_fill(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  let want_refl = me.refl_t < -1.5;
  let want_refr = me.refr_t < -1.5;
  if !want_refl && !want_refr {
    return;
  }
  let ix = i32(gid.x);
  let iy = i32(gid.y);
  let ndv0 = refl_ndv0(me, gid.xy);
  let bx = ix & ~1;
  let by = iy & ~1;
  var cand = array<vec2<i32>, 5>(vec2<i32>(bx, by), vec2<i32>(bx - 2, by), vec2<i32>(bx + 2, by), vec2<i32>(bx, by - 2), vec2<i32>(bx, by + 2));
  var got_refl = !want_refl;
  var got_refr = !want_refr;
  for (var k = 0u; k < 5u; k = k + 1u) {
    if got_refl && got_refr {
      break;
    }
    let cx = refl_clamp_x(cand[k].x);
    let cy = refl_clamp_y(cand[k].y);
    let t = shadow_aux[pixel_index(u32(cx), u32(cy))];
    if !lobe_compatible(me, t, cx, cy, ndv0) {
      continue;
    }
    if !got_refl && t.refl_t >= 0.0 {
      shadow_aux[idx].refl_color = t.refl_color;
      shadow_aux[idx].refl_color_h = t.refl_color;
      shadow_aux[idx].refl_t = t.refl_t;
      shadow_aux[idx].refl_radius_px = t.refl_radius_px;
      got_refl = true;
    }
    if !got_refr && t.refr_t >= 0.0 {
      shadow_aux[idx].refr_color = t.refr_color;
      shadow_aux[idx].refr_color_h = t.refr_color;
      shadow_aux[idx].refr_t = t.refr_t;
      shadow_aux[idx].refr_radius_px = t.refr_radius_px;
      got_refr = true;
    }
  }
  // Nothing usable nearby: leave it empty rather than borrow across a
  // silhouette, and mark it absent so the blur skips it.
  if !got_refl {
    shadow_aux[idx].refl_t = -1.0;
  }
  if !got_refr {
    shadow_aux[idx].refr_t = -1.0;
  }
}

// refl_blur_h / refl_blur_v widen the glossy lobe into the blur its roughness
// implies. Separable, for the same reason the penumbra filter is: 2N taps
// instead of N^2 for the same reach.
@compute @workgroup_size(8, 8, 1) fn refl_blur_h(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  let do_refl = me.refl_t >= 0.0 && me.refl_radius_px >= 1.0;
  let do_refr = me.refr_t >= 0.0 && me.refr_radius_px >= 1.0;
  if !do_refl {
    shadow_aux[idx].refl_color_h = me.refl_color;
  }
  if !do_refr {
    shadow_aux[idx].refr_color_h = me.refr_color;
  }
  if !do_refl && !do_refr {
    return;
  }
  let ix = i32(gid.x);
  let iy = i32(gid.y);
  let ndv0 = refl_ndv0(me, gid.xy);
  // Both channels walk the same comb, each weighting it against its own
  // radius, so the neighbour records are read once rather than twice.
  let r_max = max(me.refl_radius_px, me.refr_radius_px);
  var acc_r = me.refl_color;
  var wsum_r = 1.0;
  var acc_t = me.refr_color;
  var wsum_t = 1.0;
  for (var i = 0u; i < REFL_TAPS; i = i + 1u) {
    let o = (f32(i) / f32(REFL_TAPS - 1u) * 2.0 - 1.0) * r_max;
    let tx = refl_clamp_x(ix + i32(round(o)));
    let t = shadow_aux[pixel_index(u32(tx), u32(iy))];
    if !lobe_compatible(me, t, tx, iy, ndv0) {
      continue;
    }
    let d = abs(o);
    if do_refl && t.refl_t >= 0.0 && d <= me.refl_radius_px {
      let u = d / me.refl_radius_px;
      let w = 1.0 - u * u;
      acc_r = acc_r + t.refl_color * w;
      wsum_r = wsum_r + w;
    }
    if do_refr && t.refr_t >= 0.0 && d <= me.refr_radius_px {
      let u = d / me.refr_radius_px;
      let w = 1.0 - u * u;
      acc_t = acc_t + t.refr_color * w;
      wsum_t = wsum_t + w;
    }
  }
  if do_refl {
    shadow_aux[idx].refl_color_h = acc_r / max(wsum_r, 1e-4);
  }
  if do_refr {
    shadow_aux[idx].refr_color_h = acc_t / max(wsum_t, 1e-4);
  }
}

@compute @workgroup_size(8, 8, 1) fn refl_blur_v(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  let do_refl = me.refl_t >= 0.0 && me.refl_radius_px >= 1.0;
  let do_refr = me.refr_t >= 0.0 && me.refr_radius_px >= 1.0;
  var lobe_r = me.refl_color_h;
  var lobe_t = me.refr_color_h;
  if do_refl || do_refr {
    let ix = i32(gid.x);
    let iy = i32(gid.y);
    let ndv0 = refl_ndv0(me, gid.xy);
    let r_max = max(me.refl_radius_px, me.refr_radius_px);
    var acc_r = me.refl_color_h;
    var wsum_r = 1.0;
    var acc_t = me.refr_color_h;
    var wsum_t = 1.0;
    for (var i = 0u; i < REFL_TAPS; i = i + 1u) {
      let o = (f32(i) / f32(REFL_TAPS - 1u) * 2.0 - 1.0) * r_max;
      let ty = refl_clamp_y(iy + i32(round(o)));
      let t = shadow_aux[pixel_index(u32(ix), u32(ty))];
      if !lobe_compatible(me, t, ix, ty, ndv0) {
        continue;
      }
      let d = abs(o);
      if do_refl && t.refl_t >= 0.0 && d <= me.refl_radius_px {
        let u = d / me.refl_radius_px;
        let w = 1.0 - u * u;
        acc_r = acc_r + t.refl_color_h * w;
        wsum_r = wsum_r + w;
      }
      if do_refr && t.refr_t >= 0.0 && d <= me.refr_radius_px {
        let u = d / me.refr_radius_px;
        let w = 1.0 - u * u;
        acc_t = acc_t + t.refr_color_h * w;
        wsum_t = wsum_t + w;
      }
    }
    if do_refl {
      lobe_r = acc_r / max(wsum_r, 1e-4);
    }
    if do_refr {
      lobe_t = acc_t / max(wsum_t, 1e-4);
    }
  }
  // Parked back in colour so aa_resolve can hand a tap the neighbourhood's
  // conclusion instead of the tap's own unfiltered lobes. Safe to overwrite:
  // every invocation reads neighbours' *_color_h, never their *_color.
  shadow_aux[idx].refl_color = lobe_r;
  shadow_aux[idx].refr_color = lobe_t;
  let col = max(hdr_pixels[idx].xyz + lobe_r + lobe_t, vec3<f32>(0.0, 0.0, 0.0));
  hdr_pixels[idx] = vec4<f32>(col, display_luma(col));
  write_pixel(vec2<u32>(gid.xy), col);
}

// SHADOW_SOFTEN_TAPS is how many neighbours the penumbra filter gathers.
//
// This is a filter width, not a sample count in the sampling sense: every tap
// reads an *exact* visibility that some pixel already computed with a real ray.
// More taps make a smoother gradient, they do not reduce noise, because there is
// no noise to reduce. That is the whole reason this beats jittering the shadow
// ray, which could only ever produce TAPS+1 discrete levels and paid a BVH
// traversal for each one.
// Taps per 1D pass. Separability is what makes a wide radius affordable: this
// many per axis reaches SHADOW_SOFTEN_MAX_PX at a density a 2D disc would need
// its square to match.
const SHADOW_SOFTEN_TAPS: u32 = 61u;

// TAPS and MAX_PX are a matched pair, and matching them is what removes the need
// to jitter. One more than twice MAX_PX means the comb steps at most one pixel
// at the widest radius, so it never skips a pixel and has nothing to alias
// against. An earlier version jittered the offsets per pixel to break up ridges,
// which was treating the symptom: neighbouring pixels then averaged different
// tap sets, and every penumbra carried noise at three times the dither floor —
// worst on grazing surfaces, where a shadow edge crosses the most geometry per
// pixel. Removing the jitter dropped that to the floor exactly.
//
// If MAX_PX is ever raised, raise TAPS with it or the comb starts skipping.
// SHADOW_SOFTEN_MAX_PX bounds the gather radius so a huge penumbra cannot turn
// this into a full-screen blur. It is a *shoulder*, not a clip — see
// shadow_radius().
const SHADOW_SOFTEN_MAX_PX: f32 = 30.0;

// Below this width the geometric penumbra is drawn exactly, with no compression
// at all. This is the range contact hardening lives in: an occluder touching a
// surface gives pen_px near zero and has to stay a hard edge, and anything that
// inflates small widths would soften every contact in the scene.
const SHADOW_SOFTEN_KNEE_PX: f32 = 4.0;

// The borrow that finds each pixel's radius samples the pen_px field, which is a
// smooth geometric quantity — it does not need one tap per pixel the way the
// fraction gather does. Every other pixel over the full reach is plenty.
const SHADOW_RADIUS_TAPS: u32 = 31u;

// After the max, the radius field is blurred over a reach proportional to the
// radius being smoothed, capped here. Proportional is load-bearing: a fixed reach
// wider than the plateau it is smoothing averages that plateau with the zeros
// around it and shrinks it. At a fixed 9 px every small penumbra in the contact
// test fell under the 1 px cutoff and the scene came back with hard shadows.
// Smoothing each feature at its own scale leaves small radii intact and still
// spreads the large steps that cause seams.
//
// The max is a
// dilation: it produces a plateau at the full width across a shadow's footprint
// and drops to the local value in one pixel at the rim. That cliff is invisible
// on the shadow that *produced* it, because the gather's parabola weight is
// already zero there — but any *other* shadow crossing the rim gets blurred at
// two different widths on either side of an invisible line, which is exactly
// the seam that shows up wherever a soft and a hard shadow share a surface.
//
// Blurring after the max is what fixes it without the erosion a distance taper
// causes: a blur leaves the interior of a plateau untouched, so pixels beside a
// shadow keep the full radius and the exchange stays symmetric. Only the rim
// becomes a gradient.
// How far past its own width a shadow keeps handing its radius outward, as a
// fraction of that width, tapering linearly to nothing.
//
// The dilation's reach test used to be a step: a tap within `tp` of this pixel
// contributed its *entire* width, and one pixel further contributed none. The
// first tap to satisfy it therefore moved the radius the whole way at once. On
// the atrium ceiling the raw penumbra field ramps 0.3 -> 11 px over six pixels,
// which is a perfectly smooth boundary; the dilation turned that into a plateau
// extending sixteen pixels further out and ending in a *four*-pixel cliff, at a
// position set by nothing in the scene -- just where distance-to-the-wide-region
// first fell below that region's own width. That cliff is an iso-line of the
// penumbra field, so it draws a clean curve across the ceiling, and a coherent
// curve is visible far below the contrast at which a scattered pixel would be.
//
// Tapering past `tp` only *adds* radius where there was none, so the plateau
// inside `tp` -- which is what keeps the light exchange symmetric and the umbra
// from eroding -- is untouched.
const SHADOW_DILATE_FEATHER: f32 = 1.0;

const SHADOW_RADIUS_SMOOTH_FRAC: f32 = 0.5;

const SHADOW_RADIUS_SMOOTH_MAX_PX: f32 = 9.0;

const SHADOW_RADIUS_SMOOTH_TAPS: u32 = 9u;

// The blur fades in across this range of radii instead of switching on, so a
// penumbra narrowing toward sub-pixel does not pop as the camera moves.
const SHADOW_SOFTEN_FADE_LO: f32 = 1.0;

const SHADOW_SOFTEN_FADE_HI: f32 = 2.5;

const PENUMBRA_FILTER_EPS: f32 = 1e-4;

// Surface-continuity thresholds for the gather. MIN_DOT rejects a corner,
// DEPTH_REL is the slack added to the plane-consistent depth allowance, and
// MIN_NDV caps how much that allowance can grow at grazing angles before it
// would start accepting anything.
const SHADOW_SOFTEN_MIN_DOT: f32 = 0.85;

const SHADOW_SOFTEN_DEPTH_REL: f32 = 0.01;

// Below this the tap's view ray is nearly parallel to the surface and the plane
// prediction is unusable, so the tap is rejected rather than guessed at.
const SHADOW_SOFTEN_MIN_DENOM: f32 = 0.02;

// Same surface? Normal agreement rejects corners; a plane test rejects
// silhouettes. Neither cares where one primitive ends and the next begins, which
// is the point: the AA fingerprint is per primitive, and a wall of panels is
// covered in primitive boundaries that are not surface boundaries.
//
// The depth test predicts, rather than tolerates. Extend this pixel's surface as
// a plane and ask where the *tap's* view ray would cross it: for a plane through
// P0 = cam + v0*depth0 with normal n, that is depth0 * (n·v0) / (n·v_tap). A tap
// on the same surface matches within a hair; one on a silhouette does not.
//
// The previous form allowed a slop of px_world * rad * slope, with slope growing
// as 1/(n·v) at grazing angles. On a long obliquely-viewed floor that reached
// ~43% of the depth — tens of world units — so it accepted almost anything and
// shadows bled straight through walls. Predicting the plane removes the
// dependence on obliquity entirely, so the tolerance can stay tight at any angle.
fn shadow_same_surface(me: ShadowAux, t: ShadowAux, tx: i32, ty: i32, ndv0: f32) -> bool {
  if dot(t.normal, me.normal) < SHADOW_SOFTEN_MIN_DOT {
    return false;
  }
  let v_tap = pixel_ray_dir(f32(tx), f32(ty), 0.5, 0.5);
  let denom = dot(me.normal, v_tap);
  if abs(denom) < SHADOW_SOFTEN_MIN_DENOM {
    return false;
  }
  let t_pred = me.depth * ndv0 / denom;
  return abs(t.depth - t_pred) <= me.depth * SHADOW_SOFTEN_DEPTH_REL;
}

// Clamped tap coordinate, so the plane prediction is evaluated at the pixel the
// gather actually reads.
fn shadow_clamp_x(x: i32) -> i32 {
  return clamp(x, 0, i32(params.width) - 1);
}

fn shadow_clamp_y(y: i32) -> i32 {
  return clamp(y, 0, i32(params.height) - 1);
}

// The geometric penumbra width, compressed into the width the filter can afford
// to gather.
//
// `min(pen, MAX)` was the obvious way to bound this and it destroys the effect it
// is bounding. Real penumbrae far exceed the cap: measured across one office
// frame, the median blocked pixel wants 164 px and 85% want more than the 10 px
// cap that used to be here, so nearly every shadow in the frame clamped to the
// *same* radius. Contact hardening was still computed correctly and then thrown
// away — a cone lamp whose shadow genuinely runs from ~20 px of penumbra near the
// shade to ~250 px across the room was drawn with one uniform blur end to end.
//
// This is the same problem as tonemapping radiance, and it takes the same answer:
// identity in the range you care about, then a shoulder that compresses instead
// of clipping. The hyperbola has slope 1 at the knee, so the join is smooth, and
// approaches MAX without ever reaching it, so two very wide penumbrae still order
// correctly instead of collapsing onto one value.
//
// Widening MAX is nearly free — the filter is memory-bound, and 10 -> 30 px with
// the tap count tripled to match measured identically on the server room (8.8 ms)
// and the villa (23.3) — so the shoulder only has to absorb the tail.
// Full width out to `tp`, then a linear taper to nothing at tp*(1+FEATHER).
// Constant inside the plateau, so this changes only the rim.
fn shadow_dilate_weight(d: f32, tp: f32) -> f32 {
  let feather = max(tp * SHADOW_DILATE_FEATHER, 1e-3);
  return clamp((tp + feather - d) / feather, 0.0, 1.0);
}

fn shadow_radius(pen: f32) -> f32 {
  if pen <= SHADOW_SOFTEN_KNEE_PX {
    return pen;
  }
  let e = pen - SHADOW_SOFTEN_KNEE_PX;
  let s = SHADOW_SOFTEN_MAX_PX - SHADOW_SOFTEN_KNEE_PX;
  return SHADOW_SOFTEN_KNEE_PX + s * e / (e + s);
}

fn shadow_tap(x: i32, y: i32) -> ShadowAux {
  let cx = u32(clamp(x, 0, i32(params.width) - 1));
  let cy = u32(clamp(y, 0, i32(params.height) - 1));
  return shadow_aux[pixel_index(cx, cy)];
}

// n·v for this pixel's own view ray, the numerator of the plane prediction.
fn shadow_ndv0(me: ShadowAux, gid: vec2<u32>) -> f32 {
  return dot(me.normal, pixel_ray_dir(f32(gid.x), f32(gid.y), 0.5, 0.5));
}

// shadow_soften_h and shadow_soften_v widen each pixel's hard shadow into a
// penumbra of the width its blocker distance implies, by averaging the exact
// occlusions around it.
//
// Split into two 1D passes because the radius has to be large. A disc needs four
// times the taps for twice the radius, so a single 2D pass could only afford
// about 14 px — and a penumbra that should span 40 px, blurred over 14, still
// reads as a hard edge with a faint gradient, at a tap density low enough to be
// visibly noisy. Separating costs 2N taps instead of N² for the same reach.
// The filter runs as four dispatches, not two, because the gather radius has to
// be a *smooth* field and has to exist before any fraction is blurred.
//
// radius_h and radius_v establish it: a separable maximum of each pixel's own
// penumbra width over the neighbours that can reach it. soften_h and soften_v
// then smooth that field and gather the fraction with it. Splitting them also
// fixes a smaller inconsistency in the old two-pass form, where the row gather
// used a row-only radius while the column gather used the full 2D one.
//
// Field reuse keeps ShadowAux at 64 bytes: pen_px is dead once radius_h has read
// it, so radius_v parks the 2D maximum there; r_h is dead once radius_v has read
// it, so soften_h parks the smoothed radius there for soften_v. Each pass only
// ever writes a field no *other* invocation of that same pass reads.
// radius_h: row maximum of the penumbra width, over the neighbours that can
// actually reach this pixel.
//
// A *shadowed* pixel already knows its own blocker, so it uses its own width and
// borrows nothing. Only a lit pixel has no penumbra of its own and must take one
// from the shadow beside it, so the gradient can spread outward across the hard
// edge as well as inward.
//
// Letting shadowed pixels borrow too was the bug behind overlapping shadows
// washing out. Two occluders of the *same* light at different distances — a far
// wall and a near server rack — give very different widths, and letting the
// wall's 15 px win inside the rack's shadow blurred the rack's crisp edge three
// times too wide, which read as brighter.
//
// A borrowed width is taken whole, gated by whether the source is within its own
// reach, rather than scaled down by distance. Scaling looks like the gentler
// choice and is the one that erodes the umbra: a lit pixel d away that shrinks
// its radius to p-d then gathers over p-d, so it reaches the shadow only while
// d < p/2. The shadowed side meanwhile keeps its full p and reaches p into the
// light; the two sides exchange unequal amounts and the shadow visibly shrinks.
@compute @workgroup_size(8, 8, 1) fn shadow_radius_h(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  let ix = i32(gid.x);
  let iy = i32(gid.y);
  let ndv0 = shadow_ndv0(me, gid.xy);

  // A pixel with nothing blocked has an exactly zero fraction — no epsilon,
  // and nothing that depends on how bright the scene happens to be.
  let lit = tw_peak(me.frac) <= 0.0;
  var r = shadow_radius(me.pen_px);
  for (var i = 0u; i < SHADOW_RADIUS_TAPS && lit; i = i + 1u) {
    let o = (f32(i) / f32(SHADOW_RADIUS_TAPS - 1u) * 2.0 - 1.0) * SHADOW_SOFTEN_MAX_PX;
    let tx = shadow_clamp_x(ix + i32(round(o)));
    let t = shadow_tap(tx, iy);
    if shadow_same_surface(me, t, tx, iy, ndv0) {
      // Compressed *before* the reach test. pen_px is stored raw and can
      // run to hundreds of pixels when an occluder sits near the light, so
      // an untamed value reaches everywhere and wins the maximum over the
      // whole row. Compressing first lets distance actually decide.
      let tp = shadow_radius(t.pen_px);
      r = max(r, tp * shadow_dilate_weight(abs(o), tp));
    }
  }
  shadow_aux[idx].r_h = min(r, SHADOW_SOFTEN_MAX_PX);
}

// radius_v completes the separable maximum down each column and parks the result
// in pen_px, which nothing reads from here on.
@compute @workgroup_size(8, 8, 1) fn shadow_radius_v(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  let ix = i32(gid.x);
  let iy = i32(gid.y);
  let ndv0 = shadow_ndv0(me, gid.xy);
  let lit = tw_peak(me.frac) <= 0.0;
  var r = me.r_h;
  for (var i = 0u; i < SHADOW_RADIUS_TAPS && lit; i = i + 1u) {
    let o = (f32(i) / f32(SHADOW_RADIUS_TAPS - 1u) * 2.0 - 1.0) * SHADOW_SOFTEN_MAX_PX;
    let ty = shadow_clamp_y(iy + i32(round(o)));
    let t = shadow_tap(ix, ty);
    if shadow_same_surface(me, t, ix, ty, ndv0) {
      let tp = t.r_h;
      r = max(r, tp * shadow_dilate_weight(abs(o), tp));
    }
  }
  shadow_aux[idx].pen_px = min(r, SHADOW_SOFTEN_MAX_PX);
}

// shadow_radius_blur averages the dilated radius over a small reach. Same-surface
// only, so the field does not bleed across a silhouette and reintroduce the leak
// the plane test exists to prevent.
fn shadow_radius_blur(me: ShadowAux, ix: i32, iy: i32, ndv0: f32, own: f32, vertical: bool) -> f32 {
  let reach = clamp(own * SHADOW_RADIUS_SMOOTH_FRAC, 1.0, SHADOW_RADIUS_SMOOTH_MAX_PX);
  var acc = own;
  var wsum = 1.0;
  for (var i = 0u; i < SHADOW_RADIUS_SMOOTH_TAPS; i = i + 1u) {
    let o = (f32(i) / f32(SHADOW_RADIUS_SMOOTH_TAPS - 1u) * 2.0 - 1.0) * reach;
    var tx = ix;
    var ty = iy;
    if vertical {
      ty = shadow_clamp_y(iy + i32(round(o)));
    } else {
      tx = shadow_clamp_x(ix + i32(round(o)));
    }
    let t = shadow_tap(tx, ty);
    if !shadow_same_surface(me, t, tx, ty, ndv0) {
      continue;
    }
    let u = abs(o) / reach;
    let w = 1.0 - u * u;
    var tv = t.pen_px;
    if vertical {
      tv = t.r_h;
    }
    acc = acc + tv * w;
    wsum = wsum + w;
  }
  return acc / max(wsum, PENUMBRA_FILTER_EPS);
}

@compute @workgroup_size(8, 8, 1) fn shadow_soften_h(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  let ix = i32(gid.x);
  let iy = i32(gid.y);
  let ndv0 = shadow_ndv0(me, gid.xy);

  // Smooth the dilated radius across the row, and park it in r_h for soften_v.
  let r = shadow_radius_blur(me, ix, iy, ndv0, me.pen_px, false);
  shadow_aux[idx].r_h = r;
  if r < 1.0 {
    shadow_aux[idx].frac_h = me.frac;
    return;
  }

  // Every same-surface neighbour counts, lit ones included. Giving each tap a
  // reach of its own silently drops lit taps (their width is zero), and a lit
  // pixel then averages nothing but shadow, whose 1/(1+k) steps draw bands
  // parallel to every shadow.
  var acc = me.frac;
  var wsum = 1.0;
  for (var i = 0u; i < SHADOW_SOFTEN_TAPS; i = i + 1u) {
    let o = (f32(i) / f32(SHADOW_SOFTEN_TAPS - 1u) * 2.0 - 1.0) * r;
    let tx = shadow_clamp_x(ix + i32(round(o)));
    let t = shadow_tap(tx, iy);
    if !shadow_same_surface(me, t, tx, iy, ndv0) {
      continue;
    }
    let u = abs(o) / r;
    let w = 1.0 - u * u;
    acc = acc + t.frac * w;
    wsum = wsum + w;
  }
  shadow_aux[idx].frac_h = acc / max(wsum, PENUMBRA_FILTER_EPS);
}

@compute @workgroup_size(8, 8, 1) fn shadow_soften_v(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= params.width || gid.y >= params.height {
    return;
  }
  let idx = pixel_index(gid.x, gid.y);
  let me = shadow_aux[idx];
  // Cleared on every path that leaves the pixel alone, so supersample_edge
  // never applies a correction to a pixel this pass did not touch.
  shadow_aux[idx].soft_applied = 0.0;
  // depth is zero only where the primary ray found no diffuse surface — sky,
  // or a mirror seen head-on. There is no shadow there to widen.
  if me.depth <= 0.0 {
    return;
  }
  let ix = i32(gid.x);
  let iy = i32(gid.y);
  let ndv0 = shadow_ndv0(me, gid.xy);
  let r = shadow_radius_blur(me, ix, iy, ndv0, me.r_h, true);
  if r < SHADOW_SOFTEN_FADE_LO {
    return;
  }
  var acc = me.frac_h;
  var wsum = 1.0;
  for (var i = 0u; i < SHADOW_SOFTEN_TAPS; i = i + 1u) {
    let o = (f32(i) / f32(SHADOW_SOFTEN_TAPS - 1u) * 2.0 - 1.0) * r;
    let ty = shadow_clamp_y(iy + i32(round(o)));
    let t = shadow_tap(ix, ty);
    if !shadow_same_surface(me, t, ix, ty, ndv0) {
      continue;
    }
    let u = abs(o) / r;
    let w = 1.0 - u * u;
    acc = acc + t.frac_h * w;
    wsum = wsum + w;
  }
  let frac_soft = acc / max(wsum, PENUMBRA_FILTER_EPS);

  // Faded in rather than switched on. A sub-pixel penumbra is a hard edge and
  // must stay one, but crossing that threshold abruptly makes the blur pop in
  // as the camera approaches a shadow.
  let fade = smoothstep(SHADOW_SOFTEN_FADE_LO, SHADOW_SOFTEN_FADE_HI, r);

  // The whole correction, both directions at once: this pixel should be
  // blocking the neighbourhood-average fraction of its light rather than its
  // own hard-edged one. Shadowed pixels block more than the average and get
  // some light back; lit pixels block none and give some up.
  //
  // Both sides are the same quantity, so this cannot manufacture light. The
  // fraction is bounded by 1 and multiplied by the light the pixel would have
  // had unoccluded, so a brightened pixel lands at most on fully lit and a
  // darkened one at least on fully shadowed.
  //
  // Multiplying by *this* pixel's full light is equally load-bearing. It keeps
  // the correction textured like the surface it lands on, and it is the
  // difference between softening a shadow and running an unsharp mask over the
  // albedo underneath it.
  //
  // Expressed as a target fraction so supersample_edge can reproduce it for a
  // different sub-pixel. Identical to (me.frac - frac_soft) * me.full * fade.
  let frac_target = mix(me.frac, frac_soft, fade);
  let delta = (me.frac - frac_target) * me.full;
  let col = max(hdr_pixels[idx].xyz + delta, vec3<f32>(0.0, 0.0, 0.0));
  shadow_aux[idx].frac = frac_target;
  shadow_aux[idx].soft_applied = 1.0;
  hdr_pixels[idx] = vec4<f32>(col, display_luma(col));
  write_pixel(vec2<u32>(gid.xy), col);
}

// aa_pack_task encodes a supersample task: pixel coordinate plus which of the
// three sub-pixel taps (0.25 / 0.5 / 0.75) to use on each axis.
fn aa_pack_task(x: u32, y: u32, tap: vec2<f32>) -> u32 {
  let sxi = u32(tap.x * 4.0) - 1u; // 0.25|0.5|0.75 -> 0|1|2
  let syi = u32(tap.y * 4.0) - 1u;
  return (x & 0xfffu) | ((y & 0xfffu) << 12u) | (sxi << 24u) | (syi << 26u);
}

fn aa_task_pixel(task: u32) -> vec2<u32> {
  return vec2<u32>(task & 0xfffu, (task >> 12u) & 0xfffu);
}

// The two packed bits per axis are a *direction* — low, centre, high — not a
// literal offset, so the reach can be tuned without touching the packing.
fn aa_task_tap(task: u32) -> vec2<f32> {
  let sxi = (task >> 24u) & 3u;
  let syi = (task >> 26u) & 3u;
  let dx = f32(sxi) - 1.0;
  let dy = f32(syi) - 1.0;
  return vec2<f32>(0.5, 0.5) + AA_TAP_REACH * vec2<f32>(dx, dy);
}

// aa_classify is AA pass 2 of 3: one thread per pixel, but it only reads the
// neighbor fingerprints and luminances and appends the pixels that need work.
// Splitting classification from supersampling is what makes the AA affordable.
// Edge pixels are scattered along silhouettes, so when a single pass did both,
// almost every 64-thread workgroup contained at least one edge pixel and the
// whole workgroup was billed for a full extra ray tree while most of its lanes
// sat idle. Compacting first means aa_resolve launches only full workgroups of
// genuine work.
// Workgroup-local compaction state. Each 8x8 tile counts its own edge pixels,
// claims one contiguous block of the task list, and fills it.
var<workgroup> aa_wg_count: atomic<u32>;

var<workgroup> aa_wg_base: u32;

@compute @workgroup_size(8, 8, 1) fn aa_classify(@builtin(global_invocation_id) gid: vec3<u32>, @builtin(local_invocation_index) lidx: u32) {
  if lidx == 0u {
    atomicStore(&aa_wg_count, 0u);
  }
  workgroupBarrier();

  // No early return: every lane has to reach the barriers below, so an
  // out-of-range lane participates as simply "not flagged".
  var flagged = false;
  var task = 0u;
  if gid.x < params.width && gid.y < params.height {
    let idx = pixel_index(gid.x, gid.y);
    let edge = analyze_edge(vec2<u32>(gid.xy), aa_hits[idx], hdr_pixels[idx].w);
    if edge.w >= 0.5 {
      flagged = true;
      task = aa_pack_task(gid.x, gid.y, edge.xy);
    }
  }

  // One atomic per tile instead of one per edge pixel. The point is not the
  // reduced contention, it is that a tile's tasks come out *contiguous*: the
  // resolve pass then fills each of its workgroups from a few adjacent tiles
  // rather than from 64 unrelated points on the screen, and 64 neighbouring
  // camera rays are near-parallel where 64 scattered ones are not.
  var slot = 0u;
  if flagged {
    slot = atomicAdd(&aa_wg_count, 1u);
  }
  workgroupBarrier();
  if lidx == 0u {
    aa_wg_base = atomicAdd(&aa_dispatch[3], atomicLoad(&aa_wg_count));
  }
  workgroupBarrier();
  if !flagged {
    return;
  }
  let g = aa_wg_base + slot;
  if g >= arrayLength(&aa_list) {
    return;
  }
  aa_list[g] = task;
  atomicMax(&aa_dispatch[0], (g + AA_RESOLVE_WG) / AA_RESOLVE_WG);
}

// aa_resolve is AA pass 3 of 3: supersample the compacted task list. Dispatched
// indirectly from aa_dispatch, so its thread count tracks the number of edge
// pixels rather than the screen size.
@compute @workgroup_size(64, 1, 1) fn aa_resolve(@builtin(global_invocation_id) gid: vec3<u32>) {
  if gid.x >= atomicLoad(&aa_dispatch[3]) {
    return;
  }
  let task = aa_list[gid.x];
  let px = aa_task_pixel(task);
  let idx = pixel_index(px.x, px.y);
  let col = supersample_edge(f32(px.x), f32(px.y), hdr_pixels[idx].xyz, aa_task_tap(task), idx);
  write_pixel(px, col);
}

// Trace one probe ray.
//
// What ray_color does that a probe ray cannot use: a segment stack of
// MAX_SEGS ray records in registers, glossy and refractive lobe bookkeeping,
// the reflection filter's aux outputs, heat shimmer, ghost segments and the
// profile counters. A probe ray never branches — its further bounces come from
// the probe field, not from more segments — so all of that is register
// pressure and setup it pays for and never reads. Measured, going through
// ray_color cost +9.2 ms against this path's +6.4 ms on the villa.
//
// It shares surface_at with ray_color, so there is no second material
// dispatch to drift, and it carries the same two bounces ray_color gives a
// probe ray — specular surfaces are followed, not shaded.
fn gi_probe_trace(origin: vec3<f32>, dir: vec3<f32>) -> vec3<f32> {
  var ro = origin;
  var rd = dir;
  var tw = vec3<f32>(1.0);
  var radiance = vec3<f32>(0.0);
  for (var b = 0u; b < GI_PROBE_BOUNCES; b = b + 1u) {
    let hit = nearest_hit(ro, rd);
    if b == 0u {
      gi_probe_hit_t = min(hit.t, GI_PROBE_FAR);
    }
    // Volumetric flame emission along the segment, as ray_color gathers
    // it. A campfire's glow is light in the room whether or not a surface
    // was hit, and leaving it out darkens exactly the scene this feature
    // is tuned on.
    if params.campfire_count > 0u {
      radiance = radiance + tw * accumulate_flame(ro, rd, hit.t, params.time);
    }
    if hit.idx == 0xffffffffu {
      radiance = radiance + tw * sky(rd);
      break;
    }
    let hp = ro + rd * hit.t;
    let sf = surface_at(hit, ro, rd, hp);
    if sf.mat == MAT_EMIT {
      radiance = radiance + tw * sf.alb;
      break;
    }
    let ep = hp + sf.n * SURFACE_EPSILON;
    let last = b + 1u >= GI_PROBE_BOUNCES;

    // Specular surfaces must not be shaded as if they were diffuse.
    //
    // A window shaded diffusely is a lit wall where there should be a view
    // through to whatever is behind it, and a mirror becomes a grey panel.
    // Both *add* light, which is the wrong direction for a field that is
    // already leaking: on office-sunset, which is largely glazed, treating
    // glass as diffuse raised the excess against the path tracer from
    // 0.0012 to 0.0015.
    if (sf.mat == MAT_MIRROR || sf.mat == MAT_METAL) && !last {
      tw = tw * sf.alb * 0.96;
      ro = ep;
      rd = reflect(rd, sf.n);
      continue;
    }
    if sf.mat == MAT_GLASS && !last {
      // Straight through rather than refracted. A probe needs to not
      // treat a window as a wall; bending the ray to find out exactly
      // which part of the garden it sees is detail no 8x8 irradiance
      // map can hold.
      var transmit = sf.surf.w;
      if transmit == 0.0 {
        transmit = 0.9;
      }
      tw = tw * sf.alb * transmit;
      ro = hp - sf.n * SURFACE_EPSILON;
      continue;
    }
    radiance = radiance + tw * gi_probe_shade(hp, sf.alb, sf.n, ep, tw, rd);
    break;
  }
  return radiance;
}

// Shared across the workgroup that owns one probe: each thread contributes the
// radiance and distance of a single ray, and the reduction below turns the set
// into the probe's six-face cube.
var<workgroup> sh_probe_col: array<vec3<f32>, GI_PROBE_WG>;

var<workgroup> sh_probe_t: array<f32, GI_PROBE_WG>;

var<workgroup> sh_probe_dir: array<vec3<f32>, GI_PROBE_WG>;

// One workgroup per probe: the first GI_PROBE_RAYS lanes trace, then the whole
// workgroup shares out the texels.
//
// The obvious shape — a thread per probe, looping its rays — leaves the GPU
// almost idle: 2048 probes is 32 workgroups of long serial threads, and it
// measured the same at 256 probes as at 2048, which is the signature of a pass
// that is latency-bound rather than doing work.
//
// The dispatch is the fine cascade's probes followed by the coarse cascade's,
// so one pass refreshes a slice of each.
@compute @workgroup_size(32, 1, 1) fn gi_probe_update(@builtin(workgroup_id) wid: vec3<u32>, @builtin(local_invocation_index) lane: u32) {
  var n_fine = params.gi_probe.y;
  var n_coarse = params.gi_probe2.x;
  if (gi_bake_on()) {
    n_fine = params.gi_bake.z;
    n_coarse = 0u;
  }
  // Which of the workgroup's probes this lane belongs to, and which ray of
  // it this lane casts.
  let sub = lane / GI_PROBE_RAYS;
  let ray = lane % GI_PROBE_RAYS;
  // Dispatched as a 2D grid: a bake can have more probes than the 65,535
  // workgroups a single dimension allows, and going over that aborts the
  // process with a bare Metal assertion rather than an error.
  let flat = wid.y * params.gi_probe2.y + wid.x;
  let pi = flat * GI_PROBES_PER_WG + sub;
  if (!gi_probe_on() || flat * GI_PROBES_PER_WG >= n_fine + n_coarse) {
    // Tested on the workgroup, not the lane, so returning here cannot
    // strand anyone at the barrier below.
    return;
  }
  let live = pi < n_fine + n_coarse;
  var c = gi_cascade_fine();
  var slot = 0u;
  var cell = vec3<u32>(0u);
  if (gi_bake_on()) {
    // One sparse volume, walked by slot: the baker dispatches over every
    // active probe, so there is no schedule and no cascade.
    c = gi_bake_cascade();
    slot = pi;
    cell = gi_bake_cell_of(slot);
  } else if (pi < n_fine) {
    let total = c.dim.x * c.dim.y * c.dim.z;
    slot = (params.gi_probe.x + pi) % total;
    cell = gi_cas_local(c, slot);
  } else {
    c = gi_cascade_coarse();
    let total = c.dim.x * c.dim.y * c.dim.z;
    slot = (params.gi_probe.w + (pi - n_fine)) % max(total, 1u);
    cell = gi_cas_local(c, slot);
  }
  let origin = gi_cas_pos(c, cell);
  let rot = gi_probe_rot(params.gi_probe.z);
  if (live) {
    let dir = rot * gi_probe_dir_fixed(ray);
    gi_probe_rand = gi_probe_next(slot * 9781u + ray * 6271u + params.gi_probe.z);
    gi_in_probe = true;
    gi_probe_hit_t = GI_PROBE_FAR;
    // The megakernel's own shading, so the indirect term agrees with the
    // direct one instead of drifting from it.
    let col = gi_probe_trace(origin, dir);
    gi_in_probe = false;
    // DDGI drops the radiance of rays that land on a backface, on the
    // grounds that the probe is buried inside a mesh. That test does not
    // transfer to analytic primitives: a room here is a hollow box, so
    // every ray that hits an interior wall is a backface hit by the
    // geometric test, and applying it zeroed the radiance of essentially
    // every indoor probe ray — the field collapsed to whatever came in
    // from the sky, which read as a dim grey wash. Probe classification
    // needs a different signal in this renderer; see docs/live-gi.md.
    sh_probe_col[lane] = col;
    // Cap the recorded distance to a few cells.
    //
    // A ray that leaves through a window hits nothing and comes back with
    // GI_PROBE_FAR — ten kilometres. Blended into a texel at three percent
    // a frame, one of those drags that texel's mean into the hundreds of
    // metres, and a mean of hundreds means "nothing is ever in the way":
    // the Chebyshev test stops rejecting anything at all. Rendering the
    // recorded depth showed exactly that, saturated across every wall.
    //
    // The map only has to answer one question — is something between this
    // probe and a point at most a cell or two away — so any distance past
    // a few cells is the same answer as infinity, and clamping keeps the
    // mean in a range where the comparison means something. This is
    // DDGI's probe max ray distance.
    let cell = 1.0 / c.inv;
    sh_probe_t[lane] = min(gi_probe_hit_t, cell * GI_DEPTH_MAX_CELLS);
    sh_probe_dir[lane] = dir;
  }
  workgroupBarrier();
  if (!live) {
    return;
  }
  let base = c.base + slot * GI_PROBE_FLOATS;
  // This probe's rays occupy one run of the shared arrays.
  let ray0 = sub * GI_PROBE_RAYS;

  // The two maps are different sizes now, so they are walked separately:
  // irradiance wants a broad lobe over few texels, occlusion a sharp one
  // over many.
  let irr_per = (GI_OCT_IRR * GI_OCT_IRR) / GI_PROBE_RAYS;
  for (var q = 0u; q < irr_per; q = q + 1u) {
    let texel = ray * irr_per + q;
    let td = oct_texel_dir(vec2<u32>(texel % GI_OCT_IRR, texel / GI_OCT_IRR), GI_OCT_IRR);
    var sum = vec3<f32>(0.0);
    var wsum = 0.0;
    for (var i = 0u; i < GI_PROBE_RAYS; i = i + 1u) {
      // The broad cosine lobe: irradiance is smooth and every ray that
      // can see this texel should contribute.
      let a = max(dot(td, sh_probe_dir[ray0 + i]), 0.0);
      if (a <= 0.0) {
        continue;
      }
      sum = sum + sh_probe_col[ray0 + i] * a;
      wsum = wsum + a;
    }
    let v = clamp(sum / max(wsum, 1e-6), vec3<f32>(0.0), vec3<f32>(GI_CLAMP));
    let o = base + texel * 3u;
    ao_volume[o] = mix(ao_volume[o], v.x, GI_PROBE_HYSTERESIS);
    ao_volume[o + 1u] = mix(ao_volume[o + 1u], v.y, GI_PROBE_HYSTERESIS);
    ao_volume[o + 2u] = mix(ao_volume[o + 2u], v.z, GI_PROBE_HYSTERESIS);
  }
  let dep_per = (GI_OCT_DEPTH * GI_OCT_DEPTH) / GI_PROBE_RAYS;
  for (var q = 0u; q < dep_per; q = q + 1u) {
    let texel = ray * dep_per + q;
    let td = oct_texel_dir(vec2<u32>(texel % GI_OCT_DEPTH, texel / GI_OCT_DEPTH), GI_OCT_DEPTH);
    var d1 = 0.0;
    var d2 = 0.0;
    var dsum = 0.0;
    for (var i = 0u; i < GI_PROBE_RAYS; i = i + 1u) {
      let a = dot(td, sh_probe_dir[ray0 + i]);
      if (a <= 0.0) {
        continue;
      }
      // The sharp lobe. A texel must record how far its own direction
      // got; widen this and a probe beside a wall averages the wall in
      // with the open room grazing past it, the mean comes out far too
      // long, and nothing behind the wall is ever rejected.
      //
      // Sharpness costs samples — about one ray a frame per texel at
      // this resolution — and that is affordable only because depth is
      // geometry rather than lighting: it does not change between
      // frames, so the blend accumulates it across them.
      let a2 = a * a;
      let a4 = a2 * a2;
      let w = a4 * a4 * a4 * a4;
      if (w <= 1e-8) {
        continue;
      }
      let t = sh_probe_t[ray0 + i];
      d1 = d1 + t * w;
      d2 = d2 + t * t * w;
      dsum = dsum + w;
    }
    // No ray went this way this frame: leave what is stored rather than
    // blending toward zero, which would read as an occluder pressed
    // against the probe and reject every lookup through it.
    if (dsum > 1e-8) {
      let mo = base + GI_PROBE_MOMENTS + texel * 2u;
      let drate = select(GI_DEPTH_HYSTERESIS, bitcast<f32>(params.gi_bake.w), gi_bake_on());
      ao_volume[mo] = mix(ao_volume[mo], d1 / dsum, drate);
      ao_volume[mo + 1u] = mix(ao_volume[mo + 1u], d2 / dsum, drate);
    }
  }
}

@group(0) @binding(0) var<uniform> params: Params;

// types.wesl — Data layouts and GPU bindings.
// Defines the structs the CPU packs (Params, Prim, BVHNode, Light, …), every
// @group(0) storage/uniform binding, shared constants (primitive kinds, materials,
// ray epsilons, lighting tuning knobs), and the Hit result returned by tracing.
struct Params {
  width: u32,
  height: u32,
  prim_count: u32,
  light_count: u32,
  blocker_count: u32,
  shadows: u32,
  bvh_node_count: u32,
  blocker_bvh_node_count: u32,
  terrain_count: u32,
  water_count: u32,
  time: f32,
  max_bounce_depth: u32,
  aspect: f32,
  fov_scale: f32,
  ambient_sky: vec4<f32>, // hemispheric ambient (xyz); from [environment].ambient_sky
  ambient_ground: vec4<f32>, // hemispheric ambient (xyz); from [environment].ambient_ground
  mirror: u32, // 1 when reflections/refractions are enabled (tr.Opts.Mirror)
  cam_pos: vec4<f32>,
  fwd: vec4<f32>,
  right: vec4<f32>,
  up: vec4<f32>,
  campfire_count: u32,
  ao_enabled: u32,
  ao_nx: u32,
  ao_ny: u32,
  ao_nz: u32,
  ao_inv: f32,
  ao_cell: f32,
  ao_bias: f32,
  ao_min: vec4<f32>,
  sky: u32, // selects the procedural sky variant (see SKY_* / scene.Sky*)
  // Visible celestial body (sun/moon disc). body_enabled gates it; body_dir
  // points from the camera toward the body; body_cos_radius is cos(angular
  // radius); body_glow scales the halo; body_color.xyz is the disc radiance.
  body_enabled: u32,
  body_cos_radius: f32,
  body_glow: f32,
  body_dir: vec4<f32>,
  body_color: vec4<f32>,
  // color_quant: 0 = 8-bit dither only, 1 = 15-bit (5-5-5), 2 = crush (24 levels/ch).
  color_quant: u32,
  capture_loaded: u32,
  capture_w: u32,
  capture_h: u32,
  document_loaded: u32,
  inst_template_count: u32,
  inst_count: u32,
  inst_node_base: u32,
  inst_node_count: u32,
  blocker_section_start: u32,
  blocker_inst_base: u32,
  blocker_inst_count: u32,
  profile_enabled: u32,
  // Lengths of the two plane-index lists inside idx_tables, so the tracer
  // iterates only planes instead of scanning every primitive.
  plane_count: u32,
  blocker_plane_count: u32,
  flame_particle_count: u32,
  // adaptive_aa: when set, primary rays at pixel edges are compared; mismatches
  // trigger a 2×2 supersample for that pixel.
  adaptive_aa: u32,
  // thin_glass_ghost: when set, primary thin-glass hits spawn a second-pane
  // reflection lobe (double-pane look). Toggled in-app with key 8.
  thin_glass_ghost: u32,
  // soft_shadows: when set, main() records the dominant light's shadow into
  // shadow_aux and the shadow_soften pass widens it into a penumbra. Occupies
  // what was struct padding before light_grid_min's vec4 alignment, so Params
  // keeps its size.
  soft_shadows: u32,
  // refl_filter: when set, the primary glossy lobe is traced as an unperturbed
  // mirror ray, held out of the pixel colour in refl_aux, and blurred by the
  // refl_blur passes before being added back. Clear, and the lobe is jittered
  // and added inline as it always was.
  refl_filter: u32,
  // Light cluster grid: world -> cell index transform for light_span().
  // light_grid_inv_cell of zero collapses every point onto cell 0, which is
  // how the degenerate one-cell grid reproduces a full light loop.
  // light_grid_dim.w is where the clustered light indices start, relative to
  // the grid's own base. table_base holds the idx_tables word offsets of the
  // blocker-plane list (x) and the light grid (y), plus the number of wide
  // lights leading the grid region (z).
  light_grid_min: vec4<f32>,
  light_grid_inv_cell: vec4<f32>,
  light_grid_dim: vec4<u32>,
  table_base: vec4<u32>,
  // Live GI grid: xyz is the grid origin, w is 1/cell.
  gi_min: vec4<f32>,
  // xyz are the cell counts, w is the enable flag.
  gi_dim: vec4<u32>,
  // Coarse cascade (mode 3): origin and 1/cell, then the cell counts.
  // Scene-anchored and never moves, so it needs no toroidal indexing.
  gi2_min: vec4<f32>,
  gi2_dim: vec4<u32>,
  // Probe update schedule (mode 3). x/y are the first probe and the count
  // for the fine cascade, z seeds the per-frame rotation of the ray
  // directions, w is the first probe of the coarse cascade.
  gi_probe: vec4<u32>,
  // x is how many coarse probes to refresh this frame.
  gi_probe2: vec4<u32>,
  // Baked volume (mode 4). A sparse grid: gi_bake_min is its origin with
  // 1/spacing in w, gi_bake_dim its cell counts, and the two bases locate
  // the index grid and the slot->cell list inside ao_volume.
  //
  // Sparse because a volume that covers a level with no culling cannot be
  // dense: the villa at one metre is 3.3M cells, which is 9 GB of probes
  // and 13 MB of index. Almost all of it is empty air.
  gi_bake_min: vec4<f32>,
  gi_bake_dim: vec4<u32>,
  // x: index grid base, y: slot->cell list base, z: active probe count,
  // w: blend rate for the bake's running average, bitcast from f32.
  gi_bake: vec4<u32>,
  // x: base of the fine cascade's cell-key table, one u32 per slot. The
  // cascade is toroidal, so a slot stands for a different world cell once
  // the viewer has walked far enough; the key is how a pass notices, and
  // noticing is what stops a scrolled-in probe blending up from whatever the
  // last cell left behind.
  gi_probe3: vec4<u32>,
}

struct Hit {
  t: f32,
  idx: u32,
  kind: u32,
  inst_idx: u32, // 0xffffffff when the hit is on static (non-instanced) geometry
}

// ShadowAux is what one pixel knows about its own shadowing, summed over every
// light rather than picked from one of them: `contrib` is the direct light that
// would arrive unoccluded, `vis` the fraction of it that actually did, and
// `pen_px` the penumbra half-width in pixels implied by the blocker distances.
// std430, 32-byte stride.
//
// The point of writing it out rather than folding it straight into radiance is
// that a penumbra is a *neighbourhood* property — a pixel cannot know how far it
// sits from the shadow's edge without looking around it. Separating the
// visibility signal is what lets shadow_soften widen an exact hard shadow to any
// width without tracing a single extra ray.
// One occlusion channel, deliberately.
//
// A two-channel split by penumbra width was tried, so that two shadows of
// different softness crossing could each be filtered with their own radius. It
// introduced two worse artifacts and was reverted:
//
//   - It is not a partition of unity. `occ_a = occ*(1-u)`, `occ_b = occ*u` with
//     `u` varying per pixel by blocker distance, then filtered with *different*
//     radii, does not recombine to `occ`. On a wall whose light is fully
//     occluded, `occ` is a constant 1 while `u` still varies, so the
//     reconstruction invented a signal out of a uniform field — a shadow drawn
//     on a wall by a light that wall completely blocks.
//   - Normalising by filtered weights fixes that and breaks the penumbra: a lit
//     pixel has no wide-channel light, so its weight there is zero and it is
//     invisible to that channel. The wide channel then averages only shadowed
//     pixels, where occlusion and weight are the same field, so the ratio is
//     identically 1 and no gradient forms.
//
// With one channel `occ` is filtered directly, a uniform field stays uniform,
// and the failure mode is only that two crossing shadows share one radius.
struct ShadowAux {
  // Per channel, the fraction of this point's direct light that something is
  // blocking. Albedo cancels out of the ratio, which is the whole reason it is
  // stored as a ratio: filtering the blocked *radiance* directly turns the
  // filter into an unsharp mask on the texture, because a bright texel in
  // shadow is missing more light than the dark texel beside it. Contrast
  // inside every shadowed region blew out.
  //
  // Per channel rather than one scalar, so the quantity means the same thing
  // no matter which lights are involved. A lit pixel beside a shadow cast by a
  // warm light has to lose warm light, not grey; and a scalar occlusion is not
  // a partition of unity across several lights, which is what made a shadow
  // from a fully-occluded light darken its neighbours the wrong way.
  //
  // The vertical pass overwrites this slot with the *target* fraction it
  // filtered to — the neighbourhood average, faded in. supersample_edge then
  // reproduces the same correction for its own tap. Storing the target rather
  // than the radiance delta is what lets the tap use its own occlusion and its
  // own light; see soft_applied. Safe to reuse: no invocation reads a
  // *neighbour's* frac, only its frac_h.
  frac: vec3<f32>,
  pen_px: f32,
  // Shading normal and camera distance, so the filter can tell whether a
  // neighbour lies on the same surface. The packed primary-hit fingerprint the
  // AA pass uses is per *primitive*, and scene geometry is authored as many
  // small boxes — a rack, a wall of panels — so a continuous surface is
  // covered in fingerprint boundaries. Gating on it chopped the blur along
  // every seam and flipped it on and off as those seams moved.
  normal: vec3<f32>,
  // Zero marks a pixel with no diffuse surface (sky), which the filter skips.
  depth: f32,
  // Written by the horizontal half of the separable filter and read by the
  // vertical half: the row-blurred fraction and the row maximum of pen_px.
  frac_h: vec3<f32>,
  r_h: f32,
  // The direct light this point would receive if nothing blocked anything,
  // already scaled by throughput, AO and any glossy (1 - refl) split. This is
  // what converts a filtered fraction back into radiance, and using the
  // pixel's *own* value is what keeps the correction textured like the surface
  // it lands on instead of like its neighbours.
  full: vec3<f32>,
  // 1 once the vertical pass has written a target into frac, 0 where it left
  // the pixel alone. Without it an untouched pixel's frac still looks like a
  // target, and supersample_edge would "correct" a tap the filter never
  // touched.
  soft_applied: f32,
  // --- reflection filter ---
  //
  // The glossy lobe rides in this record rather than a buffer of its own
  // because there is no buffer of its own to be had: Metal allows a compute
  // stage 31 buffers and the megakernel uses every one (the same wall that put
  // every index list into idx_tables). It costs nothing to share — both are
  // per-pixel screen-space scratch written by main and consumed by a separable
  // filter, and the reflection filter wants `normal` and `depth` above anyway.
  //
  // A rough surface scatters the reflected ray through a fixed *angle*, so the
  // image it reflects is smeared by that angle times how far away that image
  // is. That is the penumbra filter's structure with the blocker distance
  // swapped for the reflected hit distance — a quantity a real ray already
  // measured, so this is a filter over exact data and not a reconstruction.
  // The lobe's radiance, weighted by throughput and the surface's reflect
  // fraction, held out of hdr_pixels until refl_blur_v adds it back. The
  // vertical pass overwrites it with the filtered result, so aa_resolve can
  // hand a tap the neighbourhood's conclusion instead of its own sharp lobe.
  refl_color: vec3<f32>,
  // Distance from the reflecting surface to what the reflected ray hit, or
  // negative where there is no lobe. Sizes the blur, and gates it: neighbours
  // whose reflected rays landed at very different distances are looking at
  // different objects and must not mix.
  refl_t: f32,
  // Row-blurred colour, written by the horizontal pass, read by the vertical.
  refl_color_h: vec3<f32>,
  refl_radius_px: f32,
  // The transmitted lobe, carried separately from the reflected one.
  //
  // Glass forks two lobes at one hit and blurs them by different amounts —
  // jitter_dir is called with `rough` on the reflection and `rough * 0.35` on
  // the refraction — so one shared channel could only ever draw both at one
  // width. They are also the two things an author most wants to dial
  // independently: a frosted pane that still reflects sharply, or a mirror-ish
  // pane you can barely see through. Keeping them apart from the start costs
  // 32 bytes and removes the need to unpick it later.
  refr_color: vec3<f32>,
  refr_t: f32,
  refr_color_h: vec3<f32>,
  refr_radius_px: f32,
  // The reflecting/refracting surface itself, for the same-surface gate and
  // for the apparent-distance term in the radius.
  //
  // Deliberately not the `normal`/`depth` above. Those are written only by a
  // *diffuse* primary hit, and glass never takes that path — but filling them
  // in for glass would also enrol glass pixels in the penumbra filter's
  // gathers carrying frac = 0, which reads as "fully lit" and would lighten
  // every shadow beside a window.
  lobe_normal: vec3<f32>,
  lobe_depth: f32,
}

const MAT_DIFFUSE: u32 = 0u;

@group(0) @binding(2) var<storage, read> prims: array<Prim>;

const HIT_NO_INSTANCE: u32 = 0xffffffffu;

const PRIM_FLAG_TRANSFORMED: u32 = 1u;

const PRIM_CONE: u32 = 4u;

// inst_local_point maps a world hit point into the template's local space.
fn inst_local_point(i: u32, wp: vec3<f32>) -> vec3<f32> {
  return inst_local_origin(i, wp);
}

fn inst_local_origin(i: u32, ro: vec3<f32>) -> vec3<f32> {
  let r = inst_records[i];
  let v = ro - vec3<f32>(r.xf0.w, r.xf1.w, r.xf2.w);
  return vec3<f32>(dot(r.xf0.xyz, v), dot(r.xf1.xyz, v), dot(r.xf2.xyz, v));
}

@group(0) @binding(15) var<storage, read> inst_records: array<InstanceRecord>;

struct InstanceRecord {
  xf0: vec4<f32>,
  xf1: vec4<f32>,
  xf2: vec4<f32>,
  template_id: u32,
  _pad0: u32,
  _pad1: u32,
  _pad2: u32,
}

// xf_to_local_dir rotates a world direction into local space (no translation).
// Rotation is orthonormal so length is preserved and the hit parameter t is
// identical in both spaces.
fn xf_to_local_dir(p: Prim, w: vec3<f32>) -> vec3<f32> {
  return vec3<f32>(dot(p.xf0.xyz, w), dot(p.xf1.xyz, w), dot(p.xf2.xyz, w));
}

// Prim mirrors GPUPrimitive in scene.go (std430, 144-byte stride).
struct Prim {
  geo_a: vec4<f32>, // sphere: center.xyz, radius | plane: n.xyz, d | box: min.xyz, holeStart
  // cylinder: cx, cz, radius, ymin | cone: cx, cz, rbase, ybase
  // torus: center.xyz, majorR
  // ring: cx, cz, radius, cy
  geo_b: vec4<f32>, // box: max.xyz, holeCount | sphere: cut_off | cylinder: ymax, radius_top | cone: ytip | torus: minorR | ring: height
  albedo: vec4<f32>, // linear rgb in xyz
  albedo2: vec4<f32>, // checker second color
  surf: vec4<f32>, // rough, ior, reflect, transmit
  info: vec4<u32>, // kind, material, texture, flags (bit0 = transformed, bit1 = thin glass)
  xf0: vec4<f32>, // world->local rotation row0 (xyz) + translation t.x (w)
  xf1: vec4<f32>, // world->local rotation row1 (xyz) + translation t.y (w)
  xf2: vec4<f32>, // world->local rotation row2 (xyz) + translation t.z (w)
  surf2: vec4<f32>, // reflect_blur, transmit_blur, spare, spare
}

// xf_to_local_point maps a world point into a transformed primitive's local
// space: inv * (w - t). The world->local rotation rows live in xf0..xf2.xyz and
// the translation in their .w lanes. Mirrors scene.Transform.LocalRay.
fn xf_to_local_point(p: Prim, w: vec3<f32>) -> vec3<f32> {
  let d = w - vec3<f32>(p.xf0.w, p.xf1.w, p.xf2.w);
  return vec3<f32>(dot(p.xf0.xyz, d), dot(p.xf1.xyz, d), dot(p.xf2.xyz, d));
}

fn cone_cap_normal_world(p: Prim, ro: vec3<f32>, hp: vec3<f32>) -> vec3<f32> {
  var plane_out = vec3<f32>(0.0, -1.0, 0.0);
  if ((p.info.w & PRIM_FLAG_TRANSFORMED) != 0u) {
    plane_out = normalize(xf_to_world_normal(p, plane_out));
  }
  let to_hit = hp - ro;
  if (dot(to_hit, plane_out) < 0.0) {
    return plane_out;
  }
  return -plane_out;
}

fn normal_at(p: Prim, hp: vec3<f32>, rd: vec3<f32>) -> vec3<f32> {
  let kind = p.info.x;
  if (FEAT_PRIM_SPHERE && kind == PRIM_SPHERE) {
    return normalize(hp - p.geo_a.xyz);
  }
  if (FEAT_PRIM_PLANE && kind == PRIM_PLANE) {
    return p.geo_a.xyz;
  }
  if (FEAT_PRIM_BOX && kind == PRIM_BOX) {
    return box_normal(p, hp);
  }
  if (FEAT_PRIM_CYLINDER && kind == PRIM_CYLINDER) {
    return cylinder_normal(p, hp);
  }
  if (FEAT_PRIM_CONE && kind == PRIM_CONE) {
    return cone_normal(p, hp, rd);
  }
  if (FEAT_PRIM_RING && kind == PRIM_RING) {
    return ring_normal(p, hp);
  }
  if (FEAT_PRIM_LENS && kind == PRIM_LENS) {
    return lens_normal(p, hp);
  }
  if (!FEAT_PRIM_TORUS) {
    return vec3<f32>(0.0, 1.0, 0.0);
  }
  return torus_normal(p, hp);
}

fn surface_grazing_weight(surface_n: vec3<f32>, to_camera: vec3<f32>) -> f32 {
  return smoothstepf(SURFACE_GRAZING_FADE_START, SURFACE_GRAZING_FADE_END, abs(dot(normalize(surface_n), normalize(to_camera))));
}

// prim_texture_bump_normal perturbs base_n from the procedural texture height field
// (flat cobble for stone_wall, tile relief for tiles). Opt in via PRIM_FLAG_TEXTURE_NORMAL_MAP.
// grazing_w fades bump at shallow view angles (see surface_grazing_weight in math.wesl).
fn prim_texture_bump_normal(p: Prim, hp: vec3<f32>, base_n: vec3<f32>, grazing_w: f32) -> vec3<f32> {
  if ((p.info.w & PRIM_FLAG_TEXTURE_NORMAL_MAP) == 0u) {
    return base_n;
  }
  let tex = p.info.z;
  if (tex != TEX_STONE_WALL && tex != TEX_TILES && tex != TEX_PARQUET_FLOOR) {
    return base_n;
  }
  if (grazing_w <= 1e-5) {
    return base_n;
  }
  var bump = prim_texture_normal_bump(p) * grazing_w;
  var eps = 0.006;
  if (tex == TEX_STONE_WALL) {
    eps = prim_pattern_scale(p, PRIM_COBBLE_CELL_DEFAULT) * 0.035;
  } else if (tex == TEX_PARQUET_FLOOR) {
    eps = prim_pattern_scale(p, PARQUET_PLANK_LEN) * 0.035;
  }
  var u = hp.x;
  var v = hp.y;
  var tu = vec3<f32>(1.0, 0.0, 0.0);
  var tv = vec3<f32>(0.0, 1.0, 0.0);
  let n = base_n;
  if (abs(n.z) >= 0.5) {
    // +Z / -Z faces use XY
  } else if (abs(n.x) > abs(n.y)) {
    u = hp.z;
    v = hp.y;
    tu = vec3<f32>(0.0, 0.0, select(-1.0, 1.0, n.x > 0.0));
    tv = vec3<f32>(0.0, 1.0, 0.0);
  } else {
    u = hp.x;
    v = hp.z;
    tu = vec3<f32>(1.0, 0.0, 0.0);
    tv = vec3<f32>(0.0, 0.0, select(-1.0, 1.0, n.y > 0.0));
  }
  let dhd_u = (prim_texture_height(p, u + eps, v) - prim_texture_height(p, u - eps, v)) / (2.0 * eps);
  let dhd_v = (prim_texture_height(p, u, v + eps) - prim_texture_height(p, u, v - eps)) / (2.0 * eps);
  var tu_b = tu + base_n * (bump * dhd_u);
  var tv_b = tv + base_n * (bump * dhd_v);
  tu_b = normalize(tu_b);
  tv_b = normalize(tv_b);
  return normalize(cross(tv_b, tu_b));
}

// xf_to_world_normal rotates a local normal back to world space using the
// local->world rotation (= inv transpose, whose columns are the inv rows).
fn xf_to_world_normal(p: Prim, ln: vec3<f32>) -> vec3<f32> {
  return vec3<f32>(p.xf0.x * ln.x + p.xf1.x * ln.y + p.xf2.x * ln.z, p.xf0.y * ln.x + p.xf1.y * ln.y + p.xf2.y * ln.z, p.xf0.z * ln.x + p.xf1.z * ln.y + p.xf2.z * ln.z);
}

// Per-primitive-kind flags. hit_prim is the hottest function in the tracer —
// roughly ten million calls a frame — and its dispatch chain keeps every kind's
// intersection body reachable, and so live for register allocation, even in a
// scene that packs none of them.
//
// These gate the *dispatch site*, not the function bodies. An earlier attempt
// put `if (!FEAT_PRIM_X) { return T_MISS; }` at the top of each hit_X instead,
// which left every call edge in place and merely made the callees trivial; that
// measured 26.5 ms -> 48.2 ms on the office scene. The likely cause is that the
// shrunken neighbours freed up inliner budget for hit_box, which carries two
// dynamically indexed 8-element arrays for hole CSG and is called from every BVH
// leaf loop. Gating the call edge leaves the kept arms byte-identical and simply
// orphans the stripped ones: same office scene, 26.2 ms -> 25.4 ms.
//
// The gap between those two shapes is far larger than the win itself, so if a
// kind ever needs gating somewhere new, gate where it is *called*, never inside
// what is called.
//
// Both dispatches on primitive kind are covered: hit_prim in intersect.wesl and
// normal_at in shade.wesl. A kind must stay enabled if it appears in prims or in
// blockers; see featuresFor in device.go.
const FEAT_PRIM_SPHERE: bool = true;

const PRIM_SPHERE: u32 = 0u;

const FEAT_PRIM_PLANE: bool = true;

const PRIM_PLANE: u32 = 1u;

const FEAT_PRIM_BOX: bool = true;

const PRIM_BOX: u32 = 2u;

const FEAT_PRIM_CYLINDER: bool = true;

const PRIM_CYLINDER: u32 = 3u;

const FEAT_PRIM_CONE: bool = true;

const FEAT_PRIM_RING: bool = true;

const PRIM_RING: u32 = 6u;

const FEAT_PRIM_LENS: bool = true;

const PRIM_LENS: u32 = 7u;

const FEAT_PRIM_TORUS: bool = true;

fn torus_normal(p: Prim, hp: vec3<f32>) -> vec3<f32> {
  let center = p.geo_a.xyz;
  let bigR = p.geo_a.w;
  let e = hp - center;
  var l = sqrt(e.x * e.x + e.z * e.z);
  if (l == 0.0) {
    l = 1e-9;
  }
  let c = vec3<f32>(e.x / l * bigR, 0.0, e.z / l * bigR);
  return normalize(e - c);
}

fn box_normal(p: Prim, hp: vec3<f32>) -> vec3<f32> {
  var best = face_axis(p.geo_a.xyz, p.geo_b.xyz, hp);
  // On the inner face of a cutout the outward normal points into the opening
  // (the negative of the hole's own face normal). Mirrors scene.Box.Normal.
  let count = u32(p.geo_b.w);
  let start = u32(p.geo_a.w);
  for (var i = 0u; i < count; i = i + 1u) {
    let hole = holes[start + i];
    let fa = face_axis(hole.mn.xyz, hole.mx.xyz, hp);
    if (fa.w < best.w) {
      best = vec4<f32>(-fa.xyz, fa.w);
    }
  }
  return best.xyz;
}

// face_axis returns (normal.xyz, dist.w): the outward axis normal of the
// [mn,mx] box face nearest to hp, plus that distance. Mirrors scene.faceAxis.
fn face_axis(mn: vec3<f32>, mx: vec3<f32>, hp: vec3<f32>) -> vec4<f32> {
  var n = vec3<f32>(-1.0, 0.0, 0.0);
  var d = abs(hp.x - mn.x);
  let dxh = abs(hp.x - mx.x);
  if (dxh < d) {
    n = vec3<f32>(1.0, 0.0, 0.0);
    d = dxh;
  }
  let dyl = abs(hp.y - mn.y);
  if (dyl < d) {
    n = vec3<f32>(0.0, -1.0, 0.0);
    d = dyl;
  }
  let dyh = abs(hp.y - mx.y);
  if (dyh < d) {
    n = vec3<f32>(0.0, 1.0, 0.0);
    d = dyh;
  }
  let dzl = abs(hp.z - mn.z);
  if (dzl < d) {
    n = vec3<f32>(0.0, 0.0, -1.0);
    d = dzl;
  }
  let dzh = abs(hp.z - mx.z);
  if (dzh < d) {
    n = vec3<f32>(0.0, 0.0, 1.0);
    d = dzh;
  }
  return vec4<f32>(n, d);
}

@group(0) @binding(12) var<storage, read> holes: array<Hole>;

// Hole mirrors GPUHole in scene.go (std430, 32-byte stride): one axis-aligned
// region subtracted from a box (CSG difference) in the box's local space.
struct Hole {
  mn: vec4<f32>,
  mx: vec4<f32>,
}

fn cylinder_normal(p: Prim, hp: vec3<f32>) -> vec3<f32> {
  let ymin = p.geo_a.w;
  let ymax = p.geo_b.x;
  if (hp.y <= ymin + 1e-3) {
    return vec3<f32>(0.0, -1.0, 0.0);
  }
  if (hp.y >= ymax - 1e-3) {
    return vec3<f32>(0.0, 1.0, 0.0);
  }
  let r0 = p.geo_a.z;
  var r1 = p.geo_b.y;
  if (r1 == 0.0) {
    r1 = r0;
  }
  let h = ymax - ymin;
  let alpha = (r1 - r0) / h;
  let ry = r0 + alpha * (hp.y - ymin);
  let dx = hp.x - p.geo_a.x;
  let dz = hp.z - p.geo_a.y;
  return normalize(vec3<f32>(dx, -ry * alpha, dz));
}

fn cone_normal(p: Prim, hp: vec3<f32>, rd: vec3<f32>) -> vec3<f32> {
  let cx = p.geo_a.x;
  let cz = p.geo_a.y;
  let rbase = p.geo_a.z;
  let ybase = p.geo_a.w;
  let ytip = p.geo_b.x;
  if (abs(hp.y - ybase) < 0.01 && p.geo_b.y > 0.5) {
    // Untransformed cones only; transformed caps use cone_cap_normal_world.
    if (rd.y > 0.0) {
      return vec3<f32>(0.0, -1.0, 0.0);
    }
    return vec3<f32>(0.0, 1.0, 0.0);
  }
  let k = rbase / (ytip - ybase);
  let lx = hp.x - cx;
  let lz = hp.z - cz;
  var lr = sqrt(lx * lx + lz * lz);
  if (lr == 0.0) {
    lr = 1e-9;
  }
  let denom = sqrt(1.0 + k * k);
  let ny = k / denom;
  let ns = 1.0 / denom;
  return vec3<f32>(lx / lr * ns, ny, lz / lr * ns);
}

fn ring_normal(p: Prim, hp: vec3<f32>) -> vec3<f32> {
  let cx = p.geo_a.x;
  let cz = p.geo_a.y;
  let cy = p.geo_a.w;
  var height = p.geo_b.x;
  if (height <= 0.0) {
    height = 0.03;
  }
  let band_half = height * 0.5;
  if (hp.y <= cy - band_half + 1e-4) {
    return vec3<f32>(0.0, -1.0, 0.0);
  }
  if (hp.y >= cy + band_half - 1e-4) {
    return vec3<f32>(0.0, 1.0, 0.0);
  }
  let lx = hp.x - cx;
  let lz = hp.z - cz;
  var l = sqrt(lx * lx + lz * lz);
  if (l == 0.0) {
    l = 1e-9;
  }
  return vec3<f32>(lx / l, 0.0, lz / l);
}

fn lens_normal(p: Prim, hp: vec3<f32>) -> vec3<f32> {
  let cx = p.geo_a.x;
  let cy = p.geo_a.y;
  let cz = p.geo_a.z;
  let r_front = p.geo_b.x;
  let r_back = p.geo_b.y;
  var thickness = p.geo_b.z;
  if (thickness <= 0.0) {
    thickness = 0.004;
  }
  let half_t = thickness * 0.5;
  let y_front = cy - half_t + r_front;
  let y_back = cy + half_t - r_back;
  if (hp.y < cy) {
    var n = vec3<f32>(hp.x - cx, hp.y - y_front, hp.z - cz);
    let l = length(n);
    if (l > 1e-12) {
      return n / l;
    }
    return vec3<f32>(0.0, -1.0, 0.0);
  }
  var n = vec3<f32>(hp.x - cx, hp.y - y_back, hp.z - cz);
  let l = length(n);
  if (l > 1e-12) {
    return n / l;
  }
  return vec3<f32>(0.0, 1.0, 0.0);
}

fn smoothstepf(e0: f32, e1: f32, x: f32) -> f32 {
  let t = clamp01((x - e0) / (e1 - e0));
  return t * t * (3.0 - 2.0 * t);
}

// Grazing-angle fade shared by water ripples and procedural normal maps. At shallow
// view angles micro-detail aliases into noise; fade it out like water ripples.
const SURFACE_GRAZING_FADE_START: f32 = 0.12;

const SURFACE_GRAZING_FADE_END: f32 = 0.42;

fn clamp01(x: f32) -> f32 {
  return clamp(x, 0.0, 1.0);
}

const PRIM_FLAG_TEXTURE_NORMAL_MAP: u32 = 4u;

const TEX_STONE_WALL: u32 = 12u;

const TEX_TILES: u32 = 14u;

const TEX_PARQUET_FLOOR: u32 = 16u;

fn prim_texture_normal_bump(p: Prim) -> f32 {
  let b = p.albedo2.z;
  if (b <= 0.0) {
    return PRIM_TEXTURE_BUMP_DEFAULT;
  }
  return b;
}

fn prim_texture_height(p: Prim, u: f32, v: f32) -> f32 {
  if (p.info.z == TEX_STONE_WALL) {
    let cell = prim_pattern_scale(p, PRIM_COBBLE_CELL_DEFAULT);
    return cobble_height_2d(vec3<f32>(0.0, 0.0, 0.0), u, v, cell);
  }
  if (p.info.z == TEX_TILES) {
    return tiles_height_2d(tiles_size(p), u, v);
  }
  if (p.info.z == TEX_PARQUET_FLOOR) {
    let plank_len = prim_pattern_scale(p, PARQUET_PLANK_LEN);
    let dims = parquet_dims(plank_len);
    return parquet_height_2d(u, v, dims.x, dims.y);
  }
  return 0.0;
}

fn prim_pattern_scale(p: Prim, fallback: f32) -> f32 {
  if (p.info.z == TEX_TILES) {
    return fallback;
  }
  let s = p.albedo2.x;
  if (s <= 0.0) {
    return fallback;
  }
  return s;
}

const PRIM_COBBLE_CELL_DEFAULT: f32 = 0.34;

const PARQUET_PLANK_LEN: f32 = 0.40;

const PRIM_TEXTURE_BUMP_DEFAULT: f32 = 1.0;

// cobble_height_2d is a flat cobblestone height field: raised stone plateaus with
// recessed mortar. Unlike stone_wall_height_2d there is no dome at each cell
// center (that reads as "pimples" when used as a terrain normal map).
fn cobble_height_2d(p: vec3<f32>, u_in: f32, v_in: f32, cell: f32) -> f32 {
  let cs = max(cell, 1e-4);
  let u = u_in / cs;
  let v = v_in / cs;
  let cu = floor(u);
  let cv = floor(v);
  let fu = u - cu;
  let fv = v - cv;
  var f1 = 1.0e9;
  var f2 = 1.0e9;
  var ox = 0.0;
  var oy = 0.0;
  for (var j = -1; j <= 1; j = j + 1) {
    for (var i = -1; i <= 1; i = i + 1) {
      let cx = cu + f32(i);
      let cy = cv + f32(j);
      let px = f32(i) + cell_rand(cx, cy, 11.0);
      let py = f32(j) + cell_rand(cx, cy, 12.0);
      let dx = px - fu;
      let dy = py - fv;
      let d = sqrt(dx * dx + dy * dy);
      if (d < f1) {
        f2 = f1;
        f1 = d;
        ox = cx;
        oy = cy;
      } else if (d < f2) {
        f2 = d;
      }
    }
  }
  let edge = f2 - f1;
  let mask = smoothstepf(0.02, 0.12, edge);
  let wear = 0.03 * (cell_rand(ox, oy, 13.0) - 0.5);
  return mask * (0.94 + wear);
}

// cell_rand is a bit-exact port of internal/texture/texture.go's integer hash,
// so brick walls match the CPU. u32 wrap-around arithmetic is identical on both
// sides (unlike the old frac(sin*43758) hash, which diverged under f32).
fn cell_rand(c: f32, r: f32, seed: f32) -> f32 {
  var h = u32(i32(c)) * 0x27d4eb2du + u32(i32(r)) * 0x9e3779b1u + u32(i32(seed)) * 0x85ebca6bu;
  h = h ^ (h >> 15u);
  h = h * 0x2c1b3c6du;
  h = h ^ (h >> 13u);
  h = h * 0x297a2d39u;
  h = h ^ (h >> 16u);
  return f32(h >> 8u) / 16777216.0;
}

fn tiles_height_2d(size: vec2<f32>, u_in: f32, v_in: f32) -> f32 {
  let fu = fract(u_in / size.x);
  let fv = fract(v_in / size.y);
  let edge = min(min(fu, 1.0 - fu), min(fv, 1.0 - fv));
  let mask = smoothstepf(0.02, 0.08, edge);
  let col = floor(u_in / size.x);
  let row = floor(v_in / size.y);
  let relief = 1.0 - 0.08 * cell_rand(col, row, 3.0);
  return mask * relief;
}

fn tiles_size(p: Prim) -> vec2<f32> {
  var w = p.albedo2.x;
  var h = p.albedo2.y;
  if (w <= 0.0) {
    w = 1.0;
  }
  if (h <= 0.0) {
    h = 1.0;
  }
  return vec2<f32>(w, h);
}

fn parquet_dims(plank_len: f32) -> vec2<f32> {
  let ratio = PARQUET_PLANK_WID / PARQUET_PLANK_LEN;
  return vec2<f32>(plank_len, plank_len * ratio);
}

fn parquet_height_2d(u_in: f32, v_in: f32, plank_len: f32, plank_wid: f32) -> f32 {
  let uv = parquet_plank_uv(u_in, v_in, plank_len, plank_wid);
  let fu = uv.z;
  let fv = uv.w;
  let mask = parquet_plank_mask(fu, fv, plank_len, plank_wid);
  let col = uv.x;
  let row = uv.y;
  let along = (col + fu) * plank_len;
  let across = (row + fv) * plank_wid;
  let grain = 0.03 * perlin(along * 28.0, across * 5.0, col + row * 0.7);
  return mask * (0.94 + grain);
}

const PARQUET_PLANK_WID: f32 = 0.10;

fn parquet_plank_uv(u: f32, v: f32, plank_len: f32, plank_wid: f32) -> vec4<f32> {
  let ru = (u + v) * PARQUET_SQRT2_HALF;
  let rv = (-u + v) * PARQUET_SQRT2_HALF;
  return parquet_herringbone(ru, rv, plank_len, plank_wid);
}

fn parquet_plank_mask(fu: f32, fv: f32, plank_len: f32, plank_wid: f32) -> f32 {
  let mx = PARQUET_MORTAR / plank_len;
  let my = PARQUET_MORTAR / plank_wid;
  return smoothstepf(0.0, mx, fu) * smoothstepf(0.0, mx, 1.0 - fu) * smoothstepf(0.0, my, fv) * smoothstepf(0.0, my, 1.0 - fv);
}

fn perlin(px: f32, py: f32, pz: f32) -> f32 {
  let xi = i32(floor(px)) & 255;
  let yi = i32(floor(py)) & 255;
  let zi = i32(floor(pz)) & 255;
  let x = px - floor(px);
  let y = py - floor(py);
  let z = pz - floor(pz);
  let u = p_fade(x);
  let v = p_fade(y);
  let w = p_fade(z);
  let a = i32(perm[u32(xi)]) + yi;
  let aa = i32(perm[u32(a)]) + zi;
  let ab = i32(perm[u32(a + 1)]) + zi;
  let b = i32(perm[u32(xi + 1)]) + yi;
  let ba = i32(perm[u32(b)]) + zi;
  let bb = i32(perm[u32(b + 1)]) + zi;
  return p_lerp(w, p_lerp(v, p_lerp(u, p_grad(i32(perm[u32(aa)]), x, y, z), p_grad(i32(perm[u32(ba)]), x - 1.0, y, z)), p_lerp(u, p_grad(i32(perm[u32(ab)]), x, y - 1.0, z), p_grad(i32(perm[u32(bb)]), x - 1.0, y - 1.0, z))), p_lerp(v, p_lerp(u, p_grad(i32(perm[u32(aa + 1)]), x, y, z - 1.0), p_grad(i32(perm[u32(ba + 1)]), x - 1.0, y, z - 1.0)), p_lerp(u, p_grad(i32(perm[u32(ab + 1)]), x, y - 1.0, z - 1.0), p_grad(i32(perm[u32(bb + 1)]), x - 1.0, y - 1.0, z - 1.0))));
}

const PARQUET_SQRT2_HALF: f32 = 0.7071067811865476;

// Herringbone plank UVs: 45° rotation, then n×1 / 1×n L-pairs
// (Blindman67 / SO 44081551). fu along the plank, fv across.
fn parquet_herringbone(u: f32, v: f32, plank_len: f32, plank_wid: f32) -> vec4<f32> {
  let n = plank_len / plank_wid;
  let px = u / plank_wid;
  let py = v / plank_wid;
  let i = floor(px);
  let j = floor(py);
  let period = n * 2.0;
  var r = i + j;
  r = r - period * floor(r / period);
  if (r < n) {
    let sx = i - r;
    return vec4<f32>(sx, j, (px - sx) / n, py - j);
  }
  let k = r - n;
  let sy = j - k;
  return vec4<f32>(i, sy, (py - sy) / n, px - i);
}

const PARQUET_MORTAR: f32 = 0.004;

// Exact port of internal/texture/noise.go: Ken Perlin's reference 3D noise over
// the uploaded permutation table, so GPU procedural textures match the CPU
// (modulo f32 vs f64 rounding) rather than approximating with value noise.
fn p_fade(t: f32) -> f32 {
  return t * t * t * (t * (t * 6.0 - 15.0) + 10.0);
}

@group(0) @binding(9) var<storage, read> perm: array<u32>;

fn p_lerp(t: f32, a: f32, b: f32) -> f32 {
  return a + t * (b - a);
}

fn p_grad(h: i32, x: f32, y: f32, z: f32) -> f32 {
  let hh = h & 15;
  var u = x;
  if (hh >= 8) {
    u = y;
  }
  var v = z;
  if (hh < 4) {
    v = y;
  } else if (hh == 12 || hh == 14) {
    v = x;
  }
  var ru = u;
  if ((hh & 1) != 0) {
    ru = -u;
  }
  var rv = v;
  if ((hh & 2) != 0) {
    rv = -v;
  }
  return ru + rv;
}

// inst_world_normal rotates a template-space normal to world space.
fn inst_world_normal(i: u32, ln: vec3<f32>) -> vec3<f32> {
  let r = inst_records[i];
  return normalize(vec3<f32>(r.xf0.x * ln.x + r.xf1.x * ln.y + r.xf2.x * ln.z, r.xf0.y * ln.x + r.xf1.y * ln.y + r.xf2.y * ln.z, r.xf0.z * ln.x + r.xf1.z * ln.y + r.xf2.z * ln.z));
}

fn texture_eval_box(prim_idx: u32, lp: vec3<f32>, ln: vec3<f32>, bmin: vec3<f32>, bmax: vec3<f32>, fallback_tex: u32, tint: vec3<f32>) -> vec3<f32> {
  var tex = box_face_texture(prim_idx, ln);
  if (tex == TEX_NONE) {
    tex = fallback_tex;
  }
  if (tex == TEX_NONE) {
    return tint;
  }
  let uv = box_face_uv(lp, ln, bmin, bmax);
  if (uv.x < 0.0) {
    return tint;
  }
  if (is_capture(tex)) {
    if (params.capture_loaded == 0u) {
      return tint;
    }
    return sample_capture(tex, uv.x, uv.y, vec3<f32>(1.0, 1.0, 1.0));
  }
  if (is_document(tex)) {
    return texture_eval_document(tex, lp, ln, bmin, bmax, tint);
  }
  let p = prims[prim_idx];
  if (tex == TEX_TILES) {
    return tex_tiles(p, lp, ln, tint);
  }
  if (tex == TEX_STONE_WALL) {
    let cell = prim_pattern_scale(p, PRIM_COBBLE_CELL_DEFAULT);
    return tex_stone_wall(lp, ln, tint, cell);
  }
  if (tex == TEX_PARQUET_FLOOR) {
    let plank_len = prim_pattern_scale(p, PARQUET_PLANK_LEN);
    return tex_parquet_floor(lp, ln, tint, plank_len);
  }
  return texture_eval(tex, lp, ln, tint);
}

// plane_albedo applies the analytic checker pattern (matching Plane.AlbedoAt)
// before any procedural texture is layered on top. Uses world X/Z, so it works
// for planes, boxes, and other finite primitives with MAT_CHECKER.
fn plane_albedo(p: Prim, hp: vec3<f32>) -> vec3<f32> {
  if (p.info.y == MAT_CHECKER) {
    let cx = i32(floor(hp.x + 0.5));
    let cz = i32(floor(hp.z + 0.5));
    if (((cx + cz) & 1) != 0) {
      return p.albedo2.xyz;
    }
  }
  return p.albedo.xyz;
}

fn box_face_texture(prim_idx: u32, ln: vec3<f32>) -> u32 {
  let face = box_face_index(ln);
  if (face < 0) {
    return TEX_NONE;
  }
  return box_face_textures[prim_idx * 6u + u32(face)];
}

const TEX_NONE: u32 = 0u;

fn box_face_uv(lp: vec3<f32>, ln: vec3<f32>, bmin: vec3<f32>, bmax: vec3<f32>) -> vec2<f32> {
  let face = box_face_index(ln);
  let dx = bmax.x - bmin.x;
  let dy = bmax.y - bmin.y;
  let dz = bmax.z - bmin.z;
  if (dx <= 0.0 || dy <= 0.0 || dz <= 0.0) {
    return vec2<f32>(-1.0, -1.0);
  }
  var u = 0.0;
  var v = 0.0;
  if (face == 4) {
    u = (lp.x - bmin.x) / dx;
    v = 1.0 - (lp.y - bmin.y) / dy;
  } else if (face == 5) {
    u = 1.0 - (lp.x - bmin.x) / dx;
    v = 1.0 - (lp.y - bmin.y) / dy;
  } else if (face == 0) {
    u = 1.0 - (lp.z - bmin.z) / dz;
    v = 1.0 - (lp.y - bmin.y) / dy;
  } else if (face == 1) {
    u = (lp.z - bmin.z) / dz;
    v = 1.0 - (lp.y - bmin.y) / dy;
  } else if (face == 2) {
    u = 1.0 - (lp.x - bmin.x) / dx;
    v = 1.0 - (lp.z - bmin.z) / dz;
  } else if (face == 3) {
    u = (lp.x - bmin.x) / dx;
    v = 1.0 - (lp.z - bmin.z) / dz;
  } else {
    return vec2<f32>(-1.0, -1.0);
  }
  return vec2(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0));
}

fn is_capture(tex: u32) -> bool {
  return tex >= TEX_CAPTURE_BASE && tex < TEX_CAPTURE_BASE + TEX_CAPTURE_COUNT;
}

fn is_document(tex: u32) -> bool {
  return tex >= TEX_DOCUMENT_BASE && tex < TEX_DOCUMENT_BASE + TEX_DOCUMENT_COUNT;
}

fn texture_eval(tex: u32, p: vec3<f32>, n: vec3<f32>, tint: vec3<f32>) -> vec3<f32> {
  if (tex == TEX_NONE) {
    return tint;
  }
  if (tex == TEX_WOOD) {
    return tex_wood(p, tint);
  }
  if (tex == TEX_BRICK) {
    return tex_brick(p, tint);
  }
  if (tex == TEX_STONE) {
    return tex_stone(p, tint);
  }
  if (tex == TEX_CEMENT) {
    return tex_cement(p, tint);
  }
  if (tex == TEX_MARBLE) {
    return tex_marble(p, tint);
  }
  if (tex == TEX_MARBLE_2) {
    return tex_marble_2(p, tint);
  }
  if (tex == TEX_GRASS) {
    return tex_grass(p, tint);
  }
  if (tex == TEX_DIRT) {
    return tex_dirt(p, tint);
  }
  if (tex == TEX_SNOW) {
    return tex_snow(p, tint);
  }
  if (tex == TEX_STONE_WALL) {
    return tex_stone_wall(p, n, tint, PRIM_COBBLE_CELL_DEFAULT);
  }
  if (tex == TEX_PARQUET_FLOOR) {
    return tex_parquet_floor(p, n, tint, PARQUET_PLANK_LEN);
  }
  if (tex == TEX_TILES) {
    return tex_tiles_2d(vec2<f32>(1.0, 1.0), p.x, p.y) * tint;
  }
  if (tex == TEX_PAPER) {
    return tex_paper(p, tint);
  }
  return tex_wallpaper(p, tint, tex);
}

fn sample_capture(tex: u32, u: f32, v: f32, tint: vec3<f32>) -> vec3<f32> {
  if (params.capture_loaded == 0u) {
    return tint;
  }
  let w = params.capture_w;
  let h = params.capture_h;
  if (w == 0u || h == 0u) {
    return tint;
  }
  let slot = tex - TEX_CAPTURE_BASE;
  let xi = min(u32(u * f32(w)), w - 1u);
  let yi = min(u32(v * f32(h)), h - 1u);
  let idx = slot * w * h + yi * w + xi;
  let px = capture_pixels[idx];
  let r = f32(px & 255u) / 255.0;
  let g = f32((px >> 8u) & 255u) / 255.0;
  let b = f32((px >> 16u) & 255u) / 255.0;
  return vec3(r * tint.x, g * tint.y, b * tint.z);
}

const TEX_CAPTURE_BASE: u32 = 50u;

@group(0) @binding(13) var<storage, read> capture_pixels: array<u32>;

fn texture_eval_document(tex: u32, lp: vec3<f32>, ln: vec3<f32>, bmin: vec3<f32>, bmax: vec3<f32>, tint: vec3<f32>) -> vec3<f32> {
  let uv = document_face_uv(lp, ln, bmin, bmax);
  if (uv.x < 0.0) {
    return tex_paper(lp, tint);
  }
  let ink = sample_document(tex, uv.x, uv.y, vec3<f32>(1.0, 1.0, 1.0));
  let grain = tex_paper(lp, vec3<f32>(1.0, 1.0, 1.0));
  return ink * (0.98 + 0.02 * grain);
}

fn document_face_uv(lp: vec3<f32>, ln: vec3<f32>, bmin: vec3<f32>, bmax: vec3<f32>) -> vec2<f32> {
  let an = abs(ln);
  if (an.z < an.x || an.z < an.y) {
    return vec2<f32>(-1.0, -1.0);
  }
  let u = (lp.x - bmin.x) / (bmax.x - bmin.x);
  let v = 1.0 - (lp.y - bmin.y) / (bmax.y - bmin.y);
  return vec2(clamp(u, 0.0, 1.0), clamp(v, 0.0, 1.0));
}

fn sample_document(tex: u32, u: f32, v: f32, tint: vec3<f32>) -> vec3<f32> {
  if (params.document_loaded == 0u) {
    return tex_paper(vec3<f32>(u * 10.0, v * 10.0, 0.0), tint);
  }
  let slot = tex - TEX_DOCUMENT_BASE;
  let w = DOCUMENT_TEX_W;
  let h = DOCUMENT_TEX_H;
  let xi = min(u32(u * f32(w)), w - 1u);
  let yi = min(u32(v * f32(h)), h - 1u);
  let idx = slot * w * h + yi * w + xi;
  let px = document_pixels[idx];
  let r = f32(px & 255u) / 255.0;
  let g = f32((px >> 8u) & 255u) / 255.0;
  let b = f32((px >> 16u) & 255u) / 255.0;
  return vec3(r * tint.x, g * tint.y, b * tint.z);
}

fn tex_paper(p: vec3<f32>, tint: vec3<f32>) -> vec3<f32> {
  let fiber = fbm(p.x * 18.0, p.y * 18.0, p.z * 18.0, 3u);
  let grain = 0.5 + 0.5 * perlin(p.x * 80.0, p.y * 80.0, p.z * 80.0);
  let base = vec3<f32>(0.96, 0.94, 0.90);
  var c = base * (0.92 + 0.08 * fiber);
  c = c * (0.95 + 0.05 * grain);
  return c * tint;
}

fn fbm(x: f32, y: f32, z: f32, octaves: u32) -> f32 {
  var sum = 0.0;
  var amp = 1.0;
  var freq = 1.0;
  var norm = 0.0;
  for (var i = 0u; i < octaves; i = i + 1u) {
    sum = sum + amp * perlin(x * freq, y * freq, z * freq);
    norm = norm + amp;
    amp = amp * 0.5;
    freq = freq * 2.0;
  }
  if (norm == 0.0) {
    return 0.0;
  }
  return sum / norm;
}

const TEX_DOCUMENT_BASE: u32 = 56u;

const DOCUMENT_TEX_W: u32 = 512u;

const DOCUMENT_TEX_H: u32 = 512u;

@group(0) @binding(19) var<storage, read> document_pixels: array<u32>;

fn tex_tiles(p: Prim, hp: vec3<f32>, n: vec3<f32>, tint: vec3<f32>) -> vec3<f32> {
  let size = tiles_size(p);
  var w = abs(n);
  w = w * w * w * w;
  let sum = w.x + w.y + w.z;
  if (sum <= 0.0) {
    return tex_tiles_2d(size, hp.x, hp.y) * tint;
  }
  let x_proj = tex_tiles_2d(size, hp.z, hp.y) * w.x;
  let y_proj = tex_tiles_2d(size, hp.x, hp.z) * w.y;
  let z_proj = tex_tiles_2d(size, hp.x, hp.y) * w.z;
  return (x_proj + y_proj + z_proj) / sum * tint;
}

fn tex_tiles_2d(size: vec2<f32>, u_in: f32, v_in: f32) -> vec3<f32> {
  let fu = fract(u_in / size.x);
  let fv = fract(v_in / size.y);
  let col = floor(u_in / size.x);
  let row = floor(v_in / size.y);
  let edge = min(min(fu, 1.0 - fu), min(fv, 1.0 - fv));
  let mask = smoothstepf(0.02, 0.08, edge);
  let bright = cell_rand(col, row, 2.0);
  var base = vec3<f32>(0.75, 0.73, 0.70) * (0.85 + 0.2 * bright);
  let mottle = 0.88 + 0.12 * fbm(col * 3.1, row * 2.7, col + row, 3u);
  let face = base * mottle;
  let mortar_col = vec3<f32>(0.28, 0.27, 0.25) * (0.8 + 0.25 * fbm(col * 5.0, row * 5.0, 0.0, 3u));
  return mix3(mortar_col, face, mask);
}

fn mix3(a: vec3<f32>, b: vec3<f32>, t: f32) -> vec3<f32> {
  return a + (b - a) * t;
}

fn tex_stone_wall(p: vec3<f32>, n: vec3<f32>, tint: vec3<f32>, cell: f32) -> vec3<f32> {
  var w = abs(n);
  // Sharpen the weights so box-like surfaces stay crisp near edges while still
  // blending smoothly on curved geometry.
  w = w * w * w * w;
  let sum = w.x + w.y + w.z;
  if (sum <= 0.0) {
    return tex_stone_wall_2d(p, p.x, p.y, cell) * tint;
  }

  // Project by dominant normal: Z-facing walls use XY, X-facing walls use ZY,
  // and horizontal surfaces use XZ.
  let x_proj = tex_stone_wall_2d(p, p.z, p.y, cell) * w.x;
  let y_proj = tex_stone_wall_2d(p, p.x, p.z, cell) * w.y;
  let z_proj = tex_stone_wall_2d(p, p.x, p.y, cell) * w.z;
  return (x_proj + y_proj + z_proj) / sum * tint;
}

fn tex_stone_wall_2d(p: vec3<f32>, u_in: f32, v_in: f32, cell: f32) -> vec3<f32> {
  let cs = max(cell, 1e-4);
  let u = u_in / cs;
  let v = v_in / cs;
  let cu = floor(u);
  let cv = floor(v);
  let fu = u - cu;
  let fv = v - cv;
  var f1 = 1.0e9;
  var f2 = 1.0e9;
  var ox = 0.0;
  var oy = 0.0;
  for (var j = -1; j <= 1; j = j + 1) {
    for (var i = -1; i <= 1; i = i + 1) {
      let cx = cu + f32(i);
      let cy = cv + f32(j);
      let px = f32(i) + cell_rand(cx, cy, 11.0);
      let py = f32(j) + cell_rand(cx, cy, 12.0);
      let dx = px - fu;
      let dy = py - fv;
      let d = sqrt(dx * dx + dy * dy);
      if (d < f1) {
        f2 = f1;
        f1 = d;
        ox = cx;
        oy = cy;
      } else if (d < f2) {
        f2 = d;
      }
    }
  }
  let edge = f2 - f1;
  let pick = cell_rand(ox, oy, 1.0);
  let bright = cell_rand(ox, oy, 2.0);
  var base = stone_wall_palette(i32(pick * 6.0));
  base = base * (0.62 + 0.55 * bright);
  base.x = base.x * (0.94 + 0.12 * cell_rand(ox, oy, 5.0));
  base.y = base.y * (0.94 + 0.12 * cell_rand(ox, oy, 6.0));
  base.z = base.z * (0.92 + 0.14 * cell_rand(ox, oy, 7.0));
  let mottle = 0.84 + 0.16 * fbm(p.x * 7.0 + ox * 3.0, p.y * 7.0 + oy * 3.0, p.z * 7.0, 4u);
  let grain = 0.90 + 0.10 * fbm(p.x * 32.0, p.y * 32.0, p.z * 32.0, 3u);
  let relief = 1.0 - 0.18 * smoothstepf(0.05, 0.5, f1);
  var face = base * (mottle * grain * relief);
  let mortar_col = vec3<f32>(0.40, 0.37, 0.31) * (0.78 + 0.30 * fbm(p.x * 6.0, p.y * 6.0, p.z * 6.0, 3u));
  let mask = smoothstepf(0.02, 0.12, edge);
  return mix3(mortar_col, face, mask);
}

fn stone_wall_palette(i: i32) -> vec3<f32> {
  var pal = array<vec3<f32>, 6>(vec3<f32>(0.80, 0.79, 0.76), vec3<f32>(0.78, 0.73, 0.62), vec3<f32>(0.64, 0.63, 0.60), vec3<f32>(0.72, 0.66, 0.54), vec3<f32>(0.74, 0.71, 0.66), vec3<f32>(0.55, 0.54, 0.52));
  var idx = i;
  if (idx < 0) {
    idx = 0;
  }
  if (idx > 5) {
    idx = 5;
  }
  return pal[idx];
}

fn tex_parquet_floor(p: vec3<f32>, n: vec3<f32>, tint: vec3<f32>, plank_len: f32) -> vec3<f32> {
  let dims = parquet_dims(plank_len);
  var w = abs(n);
  w = w * w * w * w;
  let sum = w.x + w.y + w.z;
  if (sum <= 0.0) {
    return tex_parquet_floor_2d(p, p.x, p.y, dims.x, dims.y) * tint;
  }
  let x_proj = tex_parquet_floor_2d(p, p.z, p.y, dims.x, dims.y) * w.x;
  let y_proj = tex_parquet_floor_2d(p, p.x, p.z, dims.x, dims.y) * w.y;
  let z_proj = tex_parquet_floor_2d(p, p.x, p.y, dims.x, dims.y) * w.z;
  return (x_proj + y_proj + z_proj) / sum * tint;
}

fn tex_parquet_floor_2d(p: vec3<f32>, u_in: f32, v_in: f32, plank_len: f32, plank_wid: f32) -> vec3<f32> {
  let uv = parquet_plank_uv(u_in, v_in, plank_len, plank_wid);
  let col = uv.x;
  let row = uv.y;
  let fu = uv.z;
  let fv = uv.w;
  let mask = parquet_plank_mask(fu, fv, plank_len, plank_wid);
  let face = parquet_wood_grain(p, col, row, fu, fv, plank_len, plank_wid);
  let gap_col = vec3<f32>(0.20, 0.17, 0.13) * (0.82 + 0.28 * fbm(p.x * 12.0, p.y * 12.0, p.z * 12.0, 3u));
  return mix3(gap_col, face, mask);
}

fn parquet_wood_grain(p: vec3<f32>, col: f32, row: f32, fu: f32, fv: f32, plank_len: f32, plank_wid: f32) -> vec3<f32> {
  let along = (col + fu) * plank_len;
  let across = (row + fv) * plank_wid;
  let pick = cell_rand(col, row, 1.0);
  let bright = cell_rand(col, row, 2.0);
  var base = parquet_palette(i32(pick * 5.0));
  base = base * (0.72 + 0.45 * bright);
  base.x = base.x * (0.94 + 0.12 * cell_rand(col, row, 5.0));
  base.y = base.y * (0.92 + 0.14 * cell_rand(col, row, 6.0));
  base.z = base.z * (0.90 + 0.16 * cell_rand(col, row, 7.0));
